				<Properties>
					<ProtectedString name="Source"><![CDATA[-- LocalScript в StarterPlayer > StarterPlayerScripts. Только показывает данные.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local feedback = ReplicatedStorage:WaitForChild("GameFeedback")
local stats = player:WaitForChild("leaderstats")
local coins = stats:WaitForChild("Coins")
local level = stats:WaitForChild("SpeedLevel")

local gui = Instance.new("ScreenGui")
gui.Name = "CoinSprintHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Position = UDim2.fromOffset(16, 12)
panel.Size = UDim2.new(1, -32, 0, 216)
panel.BackgroundColor3 = Color3.fromRGB(23, 32, 47)
panel.BackgroundTransparency = 0.08
panel.Parent = gui
local constraint = Instance.new("UISizeConstraint")
constraint.MaxSize = Vector2.new(340, 216)
constraint.Parent = panel
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = panel

local function makeText(y, height, size, color)
	local label = Instance.new("TextLabel")
	label.Position = UDim2.fromOffset(14, y)
	label.Size = UDim2.new(1, -28, 0, height)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = size
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = true
	label.Parent = panel
	return label
end

local white = Color3.fromRGB(242, 246, 255)
local title = makeText(10, 26, 21, Color3.fromRGB(255, 213, 82))
title.Text = "МОНЕТЫ И СКОРОСТЬ"
title.Font = Enum.Font.GothamBold
local balanceText = makeText(42, 26, 19, white)
local speedText = makeText(72, 26, 17, white)
local costText = makeText(102, 26, 17, Color3.fromRGB(112, 203, 255))
local hint = makeText(134, 68, 14, Color3.fromRGB(185, 198, 215))
hint.Text = "Мастерская — улучшения · E\nЯйцо на стенде — питомцы\nПрогресс сбрасывается при выходе."

local message = Instance.new("TextLabel")
message.AnchorPoint = Vector2.new(0.5, 0)
message.Position = UDim2.new(0.5, 0, 0, 240)
message.Size = UDim2.new(1, -32, 0, 64)
message.BackgroundColor3 = Color3.fromRGB(23, 32, 47)
message.BackgroundTransparency = 0.1
message.Font = Enum.Font.GothamBold
message.TextSize = 20
message.TextWrapped = true
message.Visible = false
message.Parent = gui
local messageLimit = Instance.new("UISizeConstraint")
messageLimit.MaxSize = Vector2.new(500, 64)
messageLimit.Parent = message
local messageCorner = Instance.new("UICorner")
messageCorner.CornerRadius = UDim.new(0, 12)
messageCorner.Parent = message

local function updateHUD()
	balanceText.Text = "Монеты: " .. coins.Value
	speedText.Text = player:GetAttribute("CurrentWorld") or "Зелёный остров"
	if level.Value >= Config.MaxSpeedLevel then
		costText.Text = "Максимальная скорость достигнута!"
	else
		costText.Text = "Следующее улучшение: " .. Config.GetUpgradeCost(level.Value) .. " монет"
	end
end

coins.Changed:Connect(updateHUD)
level.Changed:Connect(updateHUD)
updateHUD()

local messageVersion = 0
feedback.OnClientEvent:Connect(function(text, success)
	messageVersion = messageVersion + 1
	local currentVersion = messageVersion
	message.Text = text
	message.TextColor3 = success and Color3.fromRGB(121, 244, 161) or Color3.fromRGB(255, 181, 119)
	message.Visible = true
	task.delay(3, function()
		if currentVersion == messageVersion then
			message.Visible = false
		end
	end)
end)

-- Спидометр: нативные GUI-элементы, загрузка изображений не нужна.
local RunService = game:GetService("RunService")
local gauge = Instance.new("Frame")
gauge.Name = "Speedometer"
gauge.AnchorPoint = Vector2.new(1, 1)
gauge.Position = UDim2.new(1, -20, 1, -140)
gauge.Size = UDim2.fromOffset(240, 210)
gauge.BackgroundColor3 = Color3.fromRGB(10, 15, 24)
gauge.BackgroundTransparency = 0.12
gauge.Parent = gui
local rounding = Instance.new("UICorner", gauge)
rounding.CornerRadius = UDim.new(0, 18)
local border = Instance.new("UIStroke", gauge)
border.Color = Color3.fromRGB(175, 215, 255)
border.Transparency = 0.5
local scale = Instance.new("UIScale", gauge)
local segments = {}
for i = 0, 23 do
 local angle = math.rad(150 + i / 23 * 240)
 local segment = Instance.new("Frame")
 segment.AnchorPoint = Vector2.new(0.5, 0.5)
 segment.Position = UDim2.fromOffset(120 + math.cos(angle)*86, 112 + math.sin(angle)*86)
 segment.Size = UDim2.fromOffset(15, 7)
 segment.Rotation = math.deg(angle)
 segment.BorderSizePixel = 0
 segment.BackgroundColor3 = i < 16 and Color3.fromRGB(245,250,255) or (i < 20 and Color3.fromRGB(255,190,45) or Color3.fromRGB(255,65,45))
 segment.Parent = gauge
 segments[i+1] = segment
end
local needle = Instance.new("Frame")
needle.AnchorPoint = Vector2.new(0, 0.5)
needle.Position = UDim2.fromOffset(120,112)
needle.Size = UDim2.fromOffset(72,4)
needle.BorderSizePixel = 0
needle.BackgroundColor3 = Color3.new(1,1,1)
needle.ZIndex = 3
needle.Parent = gauge
-- Rotation вращает вокруг центра: отдельный прозрачный держатель задаёт ось.
local pivot = Instance.new("Frame")
pivot.AnchorPoint = Vector2.new(0.5,0.5)
pivot.Position = UDim2.fromOffset(120,112)
pivot.Size = UDim2.fromOffset(160,160)
pivot.BackgroundTransparency = 1
pivot.Parent = gauge
needle.Parent = pivot
needle.Position = UDim2.fromScale(0.5,0.5)
local hub = Instance.new("Frame")
hub.AnchorPoint = Vector2.new(0.5,0.5)
hub.Position = UDim2.fromOffset(120,112)
hub.Size = UDim2.fromOffset(16,16)
hub.BackgroundColor3 = Color3.new(1,1,1)
hub.ZIndex = 4
hub.Parent = gauge
Instance.new("UICorner",hub).CornerRadius = UDim.new(1,0)
local function gaugeText(y, height, size)
 local text = Instance.new("TextLabel")
 text.Position = UDim2.fromOffset(8,y)
 text.Size = UDim2.new(1,-16,0,height)
 text.BackgroundTransparency = 1
 text.TextColor3 = Color3.fromRGB(240,247,255)
 text.Font = Enum.Font.GothamBold
 text.TextSize = size
 text.Parent = gauge
 return text
end
local actualText = gaugeText(137,30,25)
local limitText = gaugeText(169,22,13)
local heading = gaugeText(4,24,14)
heading.Text = "СКОРОСТЬ"
local upgrades = Instance.new("TextLabel")
upgrades.Name = "UpgradeStatus"
upgrades.Position = UDim2.fromOffset(16,240)
upgrades.Size = UDim2.new(1,-32,0,125)
local upgradeLimit = Instance.new("UISizeConstraint",upgrades)
upgradeLimit.MaxSize = Vector2.new(340,125)
upgrades.BackgroundColor3 = Color3.fromRGB(23,32,47)
upgrades.BackgroundTransparency = 0.08
upgrades.TextColor3 = Color3.fromRGB(220,205,255)
upgrades.TextSize = 15
upgrades.TextWrapped = true
upgrades.Font = Enum.Font.GothamMedium
upgrades.Parent = gui
Instance.new("UICorner",upgrades).CornerRadius = UDim.new(0,12)
message.Position = UDim2.new(0.5,0,0.5,0)
local function updateUpgrades()
 local magnet = player:GetAttribute("MagnetLevel") or 0
 local petLevel = player:GetAttribute("PetLevel") or 0
 local pet = Config.Pets[petLevel]
 local income = player:GetAttribute("IncomeLevel") or 0
 upgrades.Text = string.format("Магнит: %.2f · ур. %d/%d\n%s\nПитомец: %s · x%g\n%s", Config.GetMagnetRadius(magnet),magnet,Config.MaxMagnetLevel,
  magnet < Config.MaxMagnetLevel and ("+10% радиуса: " .. Config.GetMagnetUpgradeCost(magnet) .. " монет") or "Магнит: максимум",
  pet and pet.Name or "нет",Config.GetPetMultiplier(petLevel),"Доход x" .. Config.GetIncomeMultiplier(income) .. " · Вместе x" .. (Config.GetIncomeMultiplier(income)*Config.GetPetMultiplier(petLevel)))
 updateHUD()
 limitText.Text = "Предел " .. Config.GetWalkSpeed(level.Value) .. " · ур. " .. level.Value .. "/" .. Config.MaxSpeedLevel
end
for _, attribute in ipairs({"MagnetLevel","PetLevel","IncomeLevel","CurrentWorld"}) do player:GetAttributeChangedSignal(attribute):Connect(updateUpgrades) end
level.Changed:Connect(updateUpgrades)
updateUpgrades()
local shownSpeed = 0
RunService.RenderStepped:Connect(function(dt)
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
 local speed = humanoid and humanoid.Health > 0 and Vector3.new(velocity.X,0,velocity.Z).Magnitude or 0
 shownSpeed = shownSpeed + (speed-shownSpeed)*(1-math.exp(-dt*12))
 pivot.Rotation = 150 + math.clamp(shownSpeed / Config.GetWalkSpeed(Config.MaxSpeedLevel),0,1)*240
 actualText.Text = string.format("%02d",math.floor(shownSpeed+0.5))
 local camera = workspace.CurrentCamera
 if camera then scale.Scale = math.clamp(camera.ViewportSize.Y/750,0.6,1) end
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{6377C0AE-F638-4485-BCAD-4F0494B1DB11}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">GameHUD</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5218e9e5e62045140af8f48900000517</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX_GAME_EFFECTS">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- LocalScript в StarterPlayer > StarterPlayerScripts.
-- Только оформление: питомцы и кольцо магнита. Денег и наград здесь нет.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local localPlayer = Players.LocalPlayer
local PetVisuals = require(ReplicatedStorage:WaitForChild("PetVisuals"))

if type(Config.Pets) ~= "table"
	or type(Config.GetPetMultiplier) ~= "function"
	or type(Config.GetMagnetRadius) ~= "function" then
	warn("[CoinSprint] GameEffects: обновите GameConfig для питомцев и магнита.")
	return
end

-- Объекты, созданные LocalScript, видны только на этом компьютере.
-- Каждый клиент сам рисует питомцев всех игроков по их атрибутам.
local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "CoinSprintClientFX"
effectsFolder.Parent = Workspace

local records = {}
local connections = {}
local stopped = false
local offscreen = CFrame.new(0, -10000, 0)

local function getPetLevel(player)
	local value = player:GetAttribute("PetLevel")
	if type(value) ~= "number" then
		return 0
	end
	return math.clamp(math.floor(value), 0, #Config.Pets)
end

local function getMagnetLevel()
	local value = localPlayer:GetAttribute("MagnetLevel")
	return type(value) == "number" and math.max(0, math.floor(value)) or 0
end

local function setPetVisible(record, visible)
	if record.visible == visible then
		return
	end
	record.visible = visible
	for _, entry in ipairs(record.parts) do
		if entry.part.Parent then
			entry.part.Transparency = visible and entry.transparency or 1
		end
	end
	if record.billboard then
		record.billboard.Enabled = visible
	end
end

local function refreshPet(record)
	local level = getPetLevel(record.player)
	if level == record.level then
		return
	end
	if record.model then
		record.model:Destroy()
	end
	record.level = level
	record.model = nil
	record.billboard = nil
	record.parts = {}
	record.frame = nil
	record.visible = false
	if level == 0 then
		return
	end

	local definition = Config.Pets[level]
	local model, parts = PetVisuals.Build(level)
	model.Name = "Pet_" .. record.player.UserId
	model.Parent = effectsFolder
	record.model = model
	record.parts = parts
	local body = model.PrimaryPart
	for _,entry in ipairs(parts) do entry.part.Transparency = 1 end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PetName"
	billboard.Size = UDim2.fromOffset(170, 28)
	billboard.StudsOffset = Vector3.new(0, 2.2, 0)
	billboard.MaxDistance = 45
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Parent = body
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextSize = 13
	text.TextColor3 = Color3.fromRGB(255, 248, 229)
	text.TextStrokeTransparency = 0.25
	text.Text = definition.Name .. "  x" .. string.format("%g", Config.GetPetMultiplier(level))
	text.Parent = billboard
	record.billboard = billboard
end

-- Кольцо лежит чуть выше поверхности, чтобы не мерцать внутри пола.
local ring = Instance.new("Model")
ring.Name = "LocalMagnetRadius"
ring.Parent = effectsFolder
local ringSegments = {}
local ringVisible = false
local ringRadius = -1
local segmentCount = 48
local segmentAngle = math.pi * 2 / segmentCount
for index = 1, segmentCount do
	local angleA = (index - 1) * segmentAngle
	local angleB = index * segmentAngle
	local a = Vector3.new(math.cos(angleA), 0, math.sin(angleA))
	local b = Vector3.new(math.cos(angleB), 0, math.sin(angleB))
	local part = Instance.new("Part")
	part.Name = "RingSegment"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(191, 114, 255)
	part.Size = Vector3.new(0.1, 0.07, 0.5)
	part.Transparency = 1
	part.CFrame = offscreen
	part.Parent = ring
	table.insert(ringSegments, {
		part = part,
		middle = (a + b) / 2,
		rotation = CFrame.lookAt(Vector3.zero, b - a),
	})
end

local function setRingVisible(visible)
	if ringVisible == visible then
		return
	end
	ringVisible = visible
	for _, segment in ipairs(ringSegments) do
		segment.part.Transparency = visible and 0.25 or 1
	end
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true
local function refreshRaycastFilter()
	local excluded = { effectsFolder }
	for player in pairs(records) do
		if player.Character then
			table.insert(excluded, player.Character)
		end
	end
	raycastParams.FilterDescendantsInstances = excluded
end

local function addPlayer(player)
	if records[player] then
		return
	end
	local record = { player = player, level = -1, parts = {}, connections = {}, visible = false }
	records[player] = record
	table.insert(record.connections, player:GetAttributeChangedSignal("PetLevel"):Connect(function()
		refreshPet(record)
	end))
	table.insert(record.connections, player:GetAttributeChangedSignal("CurrentWorld"):Connect(function()
		record.frame = nil -- Портал: сразу переносим питомца вместе с хозяином.
	end))
	table.insert(record.connections, player.CharacterAdded:Connect(function()
		record.frame = nil
		refreshRaycastFilter()
	end))
	table.insert(record.connections, player.CharacterRemoving:Connect(function()
		setPetVisible(record, false)
		record.frame = nil
		if player == localPlayer then
			setRingVisible(false)
		end
	end))
	refreshPet(record)
	refreshRaycastFilter()
end

local function removePlayer(player)
	local record = records[player]
	if not record then
		return
	end
	for _, connection in ipairs(record.connections) do
		connection:Disconnect()
	end
	if record.model then
		record.model:Destroy()
	end
	records[player] = nil
	refreshRaycastFilter()
end

table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
table.insert(connections, Players.PlayerRemoving:Connect(removePlayer))
for _, player in ipairs(Players:GetPlayers()) do
	addPlayer(player)
end

local elapsed = 0
local ringElapsed = 0
table.insert(connections, RunService.RenderStepped:Connect(function(deltaTime)
	if stopped then
		return
	end
	elapsed = elapsed + deltaTime
	for player, record in pairs(records) do
		if record.model then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not humanoid or humanoid.Health <= 0 or not root then
				setPetVisible(record, false)
				record.frame = nil
			else
				local _, yaw = root.CFrame:ToOrientation()
				local bob = math.sin(elapsed * 3 + player.UserId % 9) * 0.17
				local target = CFrame.new(root.Position)
					* CFrame.Angles(0, yaw, 0)
					* CFrame.new(3, -1.2 + bob, 3)
				if not record.frame or (record.frame.Position - target.Position).Magnitude > 50 then
					record.frame = target
				else
					record.frame = record.frame:Lerp(target, 1 - math.exp(-10 * deltaTime))
				end
				record.model:PivotTo(record.frame)
				setPetVisible(record, true)
			end
		end
	end

	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		setRingVisible(false)
		return
	end

	-- Питомцы следуют каждый кадр, а 48 сегментов кольца достаточно обновлять 30 раз/с.
	ringElapsed = ringElapsed + deltaTime
	if ringElapsed < 1 / 30 and ringVisible then
		return
	end
	ringElapsed = 0
	local ground = Workspace:Raycast(root.Position + Vector3.new(0, 1, 0), Vector3.new(0, -40, 0), raycastParams)
	if not ground then
		setRingVisible(false)
		return
	end
	local radius = Config.GetMagnetRadius(getMagnetLevel())
	local center = Vector3.new(root.Position.X, ground.Position.Y + 0.08, root.Position.Z)
	local chord = 2 * radius * math.sin(segmentAngle / 2) + 0.015
	for _, segment in ipairs(ringSegments) do
		if radius ~= ringRadius then
			segment.part.Size = Vector3.new(0.1, 0.07, chord)
		end
		segment.part.CFrame = CFrame.new(center + segment.middle * radius) * segment.rotation
	end
	ringRadius = radius
	setRingVisible(true)
end))

local function cleanup()
	if stopped then
		return
	end
	stopped = true
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	for player in pairs(records) do
		removePlayer(player)
	end
	effectsFolder:Destroy()
end

script.Destroying:Connect(cleanup)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{F806BC00-6D70-4F00-BF0A-BCF5BE6FD965}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
