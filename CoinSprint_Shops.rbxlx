		<Item class="ModuleScript" referent="RBX_PET_VISUALS">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Общая 3D-модель для спутника и окна открытия яйца. Заменяем здесь будущими дизайнами.
local Config = require(script.Parent:WaitForChild("GameConfig"))
local offscreen = CFrame.new(0,-10000,0)
local function addPetPart(record, name, size, position, color, shape, rotation, material, transparency)
	local part = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	if shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = offscreen * CFrame.new(position) * (rotation or CFrame.identity)
	part.Transparency = 1
	part.Parent = record.model
	table.insert(record.parts, { part = part, transparency = transparency or 0 })
	return part
end

local function addPaws(record, color, size)
	for _, x in ipairs({ -0.45, 0.45 }) do
		for _, z in ipairs({ -0.43, 0.43 }) do
			addPetPart(record, "Paw", size, Vector3.new(x, -0.47, z), color, "Ball")
		end
	end
end

local function buildFox(record, color)
	local cream = Color3.fromRGB(255, 238, 211)
	local pink = Color3.fromRGB(255, 160, 177)
	local black = Color3.fromRGB(30, 33, 46)
	local body = addPetPart(record, "Body", Vector3.new(1.2, 1, 1.4), Vector3.zero, color, "Ball")
	addPetPart(record, "Head", Vector3.new(1.3, 1.15, 1.1), Vector3.new(0, 0.45, -0.76), color, "Ball")
	addPetPart(record, "Muzzle", Vector3.new(0.86, 0.58, 0.66), Vector3.new(0, 0.22, -1.2), cream, "Ball")
	addPetPart(record, "Nose", Vector3.new(0.18, 0.15, 0.16), Vector3.new(0, 0.28, -1.53), black, "Ball")
	for _, side in ipairs({ -1, 1 }) do
		local tilt = CFrame.Angles(0, 0, -side * 0.18)
		addPetPart(record, "Ear", Vector3.new(0.45, 0.72, 0.43), Vector3.new(side * 0.44, 1.05, -0.7), color, "Wedge", tilt)
		addPetPart(record, "InnerEar", Vector3.new(0.25, 0.4, 0.2), Vector3.new(side * 0.44, 1.05, -0.94), pink, "Wedge", tilt)
		addPetPart(record, "Eye", Vector3.new(0.2, 0.25, 0.13), Vector3.new(side * 0.33, 0.63, -1.23), black, "Ball")
		addPetPart(record, "EyeSpark", Vector3.new(0.07, 0.08, 0.05), Vector3.new(side * 0.32, 0.69, -1.3), Color3.new(1, 1, 1), "Ball")
	end
	addPetPart(record, "Tail", Vector3.new(0.64, 0.65, 1.45), Vector3.new(0, 0.1, 1.05), color, "Ball", CFrame.Angles(0.45, 0, 0.15))
	addPetPart(record, "TailTip", Vector3.new(0.56, 0.56, 0.63), Vector3.new(0.08, 0.44, 1.63), cream, "Ball")
	addPaws(record, cream, Vector3.new(0.4, 0.35, 0.5))
	return body
end

local function buildRobotCat(record, color)
	local dark = Color3.fromRGB(25, 35, 58)
	local cyan = Color3.fromRGB(84, 255, 237)
	local light = color:Lerp(Color3.new(1, 1, 1), 0.35)
	local body = addPetPart(record, "Body", Vector3.new(1.18, 0.92, 1.2), Vector3.zero, color)
	addPetPart(record, "Head", Vector3.new(1.5, 1.1, 1.1), Vector3.new(0, 0.6, -0.55), light)
	addPetPart(record, "Visor", Vector3.new(1.25, 0.57, 0.12), Vector3.new(0, 0.7, -1.12), dark)
	for _, side in ipairs({ -1, 1 }) do
		addPetPart(record, "Ear", Vector3.new(0.43, 0.56, 0.5), Vector3.new(side * 0.5, 1.36, -0.52), color, "Wedge")
		addPetPart(record, "EarLight", Vector3.new(0.22, 0.3, 0.12), Vector3.new(side * 0.5, 1.36, -0.79), cyan, "Wedge", nil, Enum.Material.Neon)
		addPetPart(record, "Eye", Vector3.new(0.22, 0.25, 0.08), Vector3.new(side * 0.3, 0.77, -1.22), cyan, nil, nil, Enum.Material.Neon)
		addPetPart(record, "Cheek", Vector3.new(0.2, 0.1, 0.09), Vector3.new(side * 0.48, 0.51, -1.21), Color3.fromRGB(255, 154, 208), "Ball")
	end
	addPetPart(record, "Smile", Vector3.new(0.22, 0.07, 0.08), Vector3.new(0, 0.55, -1.22), cyan, nil, nil, Enum.Material.Neon)
	addPetPart(record, "Antenna", Vector3.new(0.1, 0.45, 0.1), Vector3.new(0, 1.39, -0.45), dark)
	addPetPart(record, "AntennaLight", Vector3.new(0.25, 0.25, 0.25), Vector3.new(0, 1.68, -0.45), cyan, "Ball", nil, Enum.Material.Neon)
	addPetPart(record, "TailBase", Vector3.new(0.22, 0.22, 0.8), Vector3.new(0, 0.05, 0.95), color)
	addPetPart(record, "TailTip", Vector3.new(0.23, 0.65, 0.23), Vector3.new(0, 0.3, 1.28), cyan, nil, nil, Enum.Material.Neon)
	addPaws(record, dark, Vector3.new(0.4, 0.32, 0.43))
	return body
end

local function buildDragon(record, color)
	local mint = Color3.fromRGB(134, 255, 222)
	local pink = Color3.fromRGB(245, 135, 255)
	local light = color:Lerp(Color3.new(1, 1, 1), 0.45)
	local black = Color3.fromRGB(34, 27, 54)
	local body = addPetPart(record, "Body", Vector3.new(1.25, 1.07, 1.6), Vector3.zero, color, "Ball")
	addPetPart(record, "Belly", Vector3.new(0.93, 0.8, 1.1), Vector3.new(0, -0.14, -0.27), light, "Ball")
	addPetPart(record, "Head", Vector3.new(1.3, 1.12, 1.14), Vector3.new(0, 0.49, -0.84), color, "Ball")
	addPetPart(record, "Muzzle", Vector3.new(0.93, 0.55, 0.74), Vector3.new(0, 0.22, -1.38), light, "Ball")
	for _, side in ipairs({ -1, 1 }) do
		addPetPart(record, "Horn", Vector3.new(0.25, 0.67, 0.32), Vector3.new(side * 0.43, 1.13, -0.7), mint, "Wedge", CFrame.Angles(0, 0, -side * 0.2), Enum.Material.Neon)
		addPetPart(record, "EyeWhite", Vector3.new(0.3, 0.35, 0.17), Vector3.new(side * 0.38, 0.66, -1.31), Color3.new(1, 1, 1), "Ball")
		addPetPart(record, "Eye", Vector3.new(0.15, 0.23, 0.1), Vector3.new(side * 0.37, 0.65, -1.4), black, "Ball")
		addPetPart(record, "Cheek", Vector3.new(0.25, 0.13, 0.1), Vector3.new(side * 0.46, 0.38, -1.35), pink, "Ball")
		addPetPart(record, "Wing", Vector3.new(1.2, 0.2, 1.5), Vector3.new(side * 1.02, 0.42, 0.18), pink, "Wedge", CFrame.Angles(0, side * 0.2, side * 0.38), Enum.Material.Neon, 0.15)
	end
	for _, z in ipairs({ 0, 0.4, 0.8 }) do
		addPetPart(record, "BackSpike", Vector3.new(0.25, 0.5, 0.35), Vector3.new(0, 0.63, z), mint, "Wedge", nil, Enum.Material.Neon)
	end
	addPetPart(record, "Tail", Vector3.new(0.6, 0.57, 1.15), Vector3.new(0, 0, 1.14), color, "Ball")
	addPetPart(record, "TailMiddle", Vector3.new(0.4, 0.4, 0.8), Vector3.new(0, 0.12, 1.84), color, "Ball", CFrame.Angles(0.3, 0, 0))
	addPetPart(record, "TailTip", Vector3.new(0.3, 0.35, 0.5), Vector3.new(0, 0.3, 2.29), mint, "Ball", nil, Enum.Material.Neon)
	addPaws(record, light, Vector3.new(0.4, 0.35, 0.5))
	return body
end


local PetVisuals = {}
function PetVisuals.Build(level)
 local definition = Config.Pets[level]
 assert(definition, "Unknown pet")
 local record = {model=Instance.new("Model"),parts={}}
 record.model.Name = definition.Name
 local build = level == 1 and buildFox or (level == 2 and buildRobotCat or buildDragon)
 record.model.PrimaryPart = build(record, definition.Color)
 for _,entry in ipairs(record.parts) do entry.part.Transparency=entry.transparency end
 record.model:PivotTo(CFrame.identity)
 return record.model, record.parts
end
return PetVisuals
]]></ProtectedString>
				<string name="ScriptGuid">{E89E0C17-6112-472E-99AC-02882A825901}</string>
