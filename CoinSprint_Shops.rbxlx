		<Item class="ModuleScript" referent="RBX_GAME_CONFIG">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Общие настройки. В Studio этот объект должен называться GameConfig.
local Config = {}

Config.CoinValue = 5              -- Награда за одну монету.
Config.CoinRespawnSeconds = 5     -- Через сколько секунд монета вернётся.
Config.BaseWalkSpeed = 16         -- Начальная скорость.
Config.SpeedPerLevel = 4          -- Прибавка за одну покупку.
Config.MaxSpeedLevel = 5          -- Всего можно купить 5 улучшений.
Config.FirstUpgradeCost = 10      -- Цены: 10, 20, 30, 40, 50.
Config.ShopDistance = 10          -- Расстояние взаимодействия с магазином.
Config.PurchaseCooldown = 0.5     -- Защита от слишком частых нажатий.
Config.ShopkeeperUserId = 1361632228 -- Аватар владельца за прилавком.
Config.MaxIncomeLevel = 10
Config.EggCost = 25
Config.EggChances = {60, 30, 10} -- Проценты: лисёнок, кот-бот, дракон.
function Config.GetIncomeMultiplier(level)
	return 1 + level * 0.25
end
function Config.GetIncomeUpgradeCost(level)
	return 15 * (level + 1)
end

function Config.GetUpgradeCost(currentLevel)
	return Config.FirstUpgradeCost * (currentLevel + 1)
end

function Config.GetWalkSpeed(level)
	return Config.BaseWalkSpeed + Config.SpeedPerLevel * level
end

Config.BaseMagnetRadius = 5
Config.MagnetRadiusGrowth = 0.10
Config.MaxMagnetLevel = 10
Config.Pets = {
	{Name = "Лисёнок", Multiplier = 1.5, Cost = 25, Color = Color3.fromRGB(255, 155, 65)},
	{Name = "Кот-бот", Multiplier = 2, Cost = 75, Color = Color3.fromRGB(75, 210, 255)},
	{Name = "Неоновый дракон", Multiplier = 3, Cost = 200, Color = Color3.fromRGB(194, 102, 255)},
}
function Config.GetMagnetRadius(level)
	return Config.BaseMagnetRadius * (1 + Config.MagnetRadiusGrowth) ^ level
end
function Config.GetMagnetUpgradeCost(level)
	return 5 * (level + 1)
end
function Config.GetPetMultiplier(level)
	local pet = Config.Pets[level]
	return pet and pet.Multiplier or 1
end
return Config
]]></ProtectedString>
				<string name="ScriptGuid">{33813099-D7DE-49C2-8526-C29273415996}</string>
