			<Item class="LocalScript" referent="RBX_SHOP_UI">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- LocalScript: меню мастерской, 3D-яйцо, анимация открытия. Деньги считает сервер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local PetVisuals = require(ReplicatedStorage:WaitForChild("PetVisuals"))
local openMenu = ReplicatedStorage:WaitForChild("GameShopOpen")
local buy = ReplicatedStorage:WaitForChild("GameShopBuy")
local hatched = ReplicatedStorage:WaitForChild("GameHatched")
local coins = player:WaitForChild("leaderstats"):WaitForChild("Coins")
local speedLevel = player.leaderstats:WaitForChild("SpeedLevel")
local gui = Instance.new("ScreenGui")
gui.Name = "WorkshopUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 20
gui.Parent = player:WaitForChild("PlayerGui")
local function frame(parent,name,size,position,color)
 local item = Instance.new("Frame")
 item.Name=name; item.Size=size; item.Position=position
 item.BackgroundColor3=color or Color3.fromRGB(23,32,47)
 item.BorderSizePixel=0; item.Parent=parent
 Instance.new("UICorner",item).CornerRadius=UDim.new(0,16)
 return item
end
local function text(parent,contents,x,y,width,height,size)
 local item=Instance.new("TextLabel")
 item.BackgroundTransparency=1; item.Position=UDim2.fromOffset(x,y)
 item.Size=UDim2.fromOffset(width,height); item.Text=contents
 item.Font=Enum.Font.GothamBold; item.TextSize=size or 18
 item.TextColor3=Color3.fromRGB(240,245,255)
 item.TextWrapped=true; item.Parent=parent
 return item
end
local function button(parent,contents,x,y,width,height)
 local item=Instance.new("TextButton")
 item.Position=UDim2.fromOffset(x,y); item.Size=UDim2.fromOffset(width,height)
 item.BackgroundColor3=Color3.fromRGB(67,151,114); item.BorderSizePixel=0
 item.Font=Enum.Font.GothamBold; item.TextSize=17
 item.TextColor3=Color3.new(1,1,1); item.Text=contents; item.Parent=parent
 Instance.new("UICorner",item).CornerRadius=UDim.new(0,10)
 return item
end
local backdrop=frame(gui,"Backdrop",UDim2.fromScale(1,1),UDim2.fromScale(0,0),Color3.new(0,0,0))
backdrop.BackgroundTransparency=0.35
backdrop.Visible=false
local panel=frame(backdrop,"ShopPanel",UDim2.fromOffset(680,450),UDim2.fromScale(0.5,0.5))
panel.AnchorPoint=Vector2.new(0.5,0.5)
local panelScale=Instance.new("UIScale",panel)
local heading=text(panel,"МАСТЕРСКАЯ",20,15,580,36,25)
local balance=text(panel,"",20,56,640,25,17)
local close=button(panel,"×",625,15,36,36)
close.BackgroundColor3=Color3.fromRGB(79,89,111)
local upgrades=frame(panel,"Upgrades",UDim2.fromOffset(640,325),UDim2.fromOffset(20,95))
upgrades.BackgroundTransparency=1
local cards={}
for i,definition in ipairs({{"speed","СКОРОСТЬ","Бегай быстрее"},{"magnet","МАГНИТ","Собирай дальше"},{"income","ДОХОД","Больше за каждую монету"}}) do
 local card=frame(upgrades,definition[1],UDim2.fromOffset(202,315),UDim2.fromOffset((i-1)*219,0),Color3.fromRGB(35,47,66))
 local accent=({Color3.fromRGB(79,175,255),Color3.fromRGB(192,118,255),Color3.fromRGB(255,202,85)})[i]
 text(card,definition[2],6,15,190,30,20).TextColor3=accent
 text(card,definition[3],12,52,178,38,14)
 local status=text(card,"",10,100,182,105,17)
 local purchase=button(card,"Купить",12,232,178,60)
 cards[definition[1]]={status=status,button=purchase}
end
local eggPanel=frame(panel,"EggPanel",UDim2.fromOffset(640,330),UDim2.fromOffset(20,95))
eggPanel.BackgroundTransparency=1
local function viewport(parent,x,y,width,height)
 local view=Instance.new("ViewportFrame")
 view.Position=UDim2.fromOffset(x,y); view.Size=UDim2.fromOffset(width,height)
 view.BackgroundTransparency=1
 view.Ambient=Color3.fromRGB(190,190,210)
 view.LightColor=Color3.fromRGB(255,245,225)
 view.LightDirection=Vector3.new(-1,-1,-2)
 view.Parent=parent
 local camera=Instance.new("Camera")
 camera.CFrame=CFrame.lookAt(Vector3.new(7,4,10),Vector3.zero)
 camera.FieldOfView=38; camera.Parent=view; view.CurrentCamera=camera
 local scene=Instance.new("WorldModel",view)
 return view,scene
end
local eggView,eggScene=viewport(eggPanel,0,0,295,270)
local odds=text(eggPanel,"",300,5,330,215,17)
local eggBuy=button(eggPanel,"",310,240,310,64)
local eggPreview
local mode,zoneId,nearPart
local function closeMenu() backdrop.Visible=false; mode=nil; nearPart=nil end
close.Activated:Connect(closeMenu)
local busyUntil=0
local function request(kind)
 if os.clock()<busyUntil or not zoneId then return end
 busyUntil=os.clock()+0.6
 buy:FireServer(kind,zoneId)
end
for kind,card in pairs(cards) do card.button.Activated:Connect(function() request(kind) end) end
eggBuy.Activated:Connect(function() request("egg") end)
local function refresh()
 balance.Text="Монеты: " .. string.format("%g",coins.Value) .. "  ·  Покупки за игровую валюту"
 local levels={speed=speedLevel.Value,magnet=player:GetAttribute("MagnetLevel") or 0,income=player:GetAttribute("IncomeLevel") or 0}
 local maxima={speed=Config.MaxSpeedLevel,magnet=Config.MaxMagnetLevel,income=Config.MaxIncomeLevel}
 local costs={speed=Config.GetUpgradeCost(levels.speed),magnet=Config.GetMagnetUpgradeCost(levels.magnet),income=Config.GetIncomeUpgradeCost(levels.income)}
 for kind,card in pairs(cards) do
  local level=levels[kind]
  local description
  if kind=="speed" then description=Config.GetWalkSpeed(level) .. " → " .. Config.GetWalkSpeed(math.min(level+1,maxima[kind])) .. " скорости"
  elseif kind=="magnet" then description=string.format("Радиус %.2f → %.2f\n+10%% к радиусу",Config.GetMagnetRadius(level),Config.GetMagnetRadius(math.min(level+1,maxima[kind])))
  else description=string.format("x%g → x%g\nУмножается с питомцем",Config.GetIncomeMultiplier(level),Config.GetIncomeMultiplier(math.min(level+1,maxima[kind]))) end
  card.status.Text="Уровень " .. level .. "/" .. maxima[kind] .. "\n" .. description
  local maximum=level>=maxima[kind]
  card.button.Text=maximum and "МАКСИМУМ" or ("Купить · " .. costs[kind])
  card.button.Active=not maximum
  card.button.BackgroundColor3=maximum and Color3.fromRGB(64,76,89) or (coins.Value>=costs[kind] and Color3.fromRGB(67,151,114) or Color3.fromRGB(106,80,82))
 end
 local lines={"ВНУТРИ ЯЙЦА"}
 for i,pet in ipairs(Config.Pets) do
  table.insert(lines,string.format("%s · x%g · %d%%\nВ коллекции: %d",pet.Name,pet.Multiplier,Config.EggChances[i],player:GetAttribute("PetOwned"..i) or 0))
 end
 odds.Text=table.concat(lines,"\n\n")
 eggBuy.Text="Открыть яйцо · " .. Config.EggCost .. " монет"
end
coins.Changed:Connect(refresh)
speedLevel.Changed:Connect(refresh)
for _,attribute in ipairs({"MagnetLevel","IncomeLevel","PetLevel","PetOwned1","PetOwned2","PetOwned3"}) do player:GetAttributeChangedSignal(attribute):Connect(refresh) end
refresh()
openMenu.OnClientEvent:Connect(function(newMode,newZone)
 local world=workspace:FindFirstChild("CoinSpeedWorld")
 local zone=world and (newZone=="neon" and world:FindFirstChild("NeonCity") or world)
 if not zone then return end
 mode=newMode; zoneId=newZone
 nearPart=mode=="egg" and zone.EggStand.Interact or zone.UpgradeShop.Counter
 heading.Text=mode=="egg" and "ЯЙЦО ПИТОМЦА" or "МАСТЕРСКАЯ УЛУЧШЕНИЙ"
 upgrades.Visible=mode~="egg"; eggPanel.Visible=mode=="egg"
 if eggPreview then eggPreview:Destroy(); eggPreview=nil end
 if mode=="egg" then
  eggPreview=zone.EggStand.EggDisplay:Clone()
  eggPreview.Parent=eggScene; eggPreview:PivotTo(CFrame.identity)
 end
 refresh(); backdrop.Visible=true
end)
UserInputService.InputBegan:Connect(function(input,processed)
 if not processed and input.KeyCode==Enum.KeyCode.Escape then closeMenu() end
end)

local reveal=frame(gui,"Hatching",UDim2.fromOffset(420,420),UDim2.fromScale(0.5,0.5),Color3.fromRGB(22,25,47))
reveal.AnchorPoint=Vector2.new(0.5,0.5); reveal.Visible=false
local revealScale=Instance.new("UIScale",reveal)
local revealTitle=text(reveal,"ЯЙЦО ОТКРЫВАЕТСЯ",10,10,400,40,23)
local revealView,revealScene=viewport(reveal,10,50,400,280)
local resultLabel=text(reveal,"",15,337,390,66,17)
local revealModel
local hatchStarted=0
local revealing=false
local revealed=false
local resultLevel,resultCount
hatched.OnClientEvent:Connect(function(level,count)
 if type(level)~="number" or not Config.Pets[level] then return end
 local source=eggPreview
 if not source then
  local world=workspace:FindFirstChild("CoinSpeedWorld")
  source=world and world.EggStand.EggDisplay
 end
 if revealModel then revealModel:Destroy() end
 revealModel=source and source:Clone() or nil
 if revealModel then revealModel.Parent=revealScene; revealModel:PivotTo(CFrame.identity) end
 resultLevel,resultCount=level,count
 closeMenu()
 hatchStarted=os.clock(); revealing=true; revealed=false
 revealTitle.Text="ЯЙЦО ОТКРЫВАЕТСЯ"
 resultLabel.Text="Сейчас появится твой питомец…"
 reveal.Visible=true; busyUntil=os.clock()+3.5
end)

-- Локальное вращение витрин не меняет серверные координаты взаимодействия.
local eggDisplays={}
local function registerEggs()
 local world=workspace:FindFirstChild("CoinSpeedWorld")
 if not world then return end
 for _,zone in ipairs({world,world:FindFirstChild("NeonCity")}) do
  local stand=zone and zone:FindFirstChild("EggStand")
  local model=stand and stand:FindFirstChild("EggDisplay")
  if model and not eggDisplays[model] then eggDisplays[model]=model:GetPivot() end
 end
end
registerEggs()
local elapsed=0
RunService.RenderStepped:Connect(function(dt)
 elapsed=elapsed+dt
 local camera=workspace.CurrentCamera
 if camera then
  local size=camera.ViewportSize
  panelScale.Scale=math.clamp(math.min(size.X/720,size.Y/530),0.3,1)
  revealScale.Scale=math.clamp(math.min(size.X/450,size.Y/470),0.3,1)
 end
 for model,base in pairs(eggDisplays) do
  if model.Parent then model:PivotTo(base*CFrame.new(0,math.sin(elapsed*1.8)*0.18,0)*CFrame.Angles(0,elapsed*0.65,0)) end
 end
 if eggPreview and eggPreview.Parent then eggPreview:PivotTo(CFrame.Angles(0,elapsed*0.8,0)) end
 if backdrop.Visible and nearPart then
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if not root or (root.Position-nearPart.Position).Magnitude>Config.ShopDistance+3 then closeMenu() end
 end
 if revealing then
  local t=os.clock()-hatchStarted
  if t<1.6 then
   if revealModel then revealModel:PivotTo(CFrame.Angles(0,t*3,math.sin(t*28)*0.1*(1+t))) end
  elseif not revealed then
   revealed=true
   if revealModel then revealModel:Destroy() end
   revealModel=PetVisuals.Build(resultLevel)
   revealModel.Parent=revealScene
   revealTitle.Text=Config.Pets[resultLevel].Name
   resultLabel.Text=string.format("Множитель x%g\n%s",Config.Pets[resultLevel].Multiplier,resultCount>1 and ("Повторный питомец · в коллекции " .. resultCount) or "Новый питомец в коллекции!")
  elseif revealModel then
   revealModel:PivotTo(CFrame.Angles(0,math.sin(t)*0.3+math.pi,0))
  end
  if t>4.2 then
   revealing=false; reveal.Visible=false
   if revealModel then revealModel:Destroy(); revealModel=nil end
  end
 end
end)
]]></ProtectedString>
