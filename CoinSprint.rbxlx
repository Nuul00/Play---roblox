Config.Eggs={
[1]={Id=1,Name="Meadow Egg",World="island",Cost=125,Position=Vector3.new(40,2,132),Color=Color3.fromRGB(106,205,151),Pool={{Pet=1,Chance=32,Weight=32000},{Pet=2,Chance=30,Weight=30000},{Pet=3,Chance=14,Weight=14000},{Pet=4,Chance=12,Weight=12000},{Pet=5,Chance=7,Weight=7000},{Pet=6,Chance=2.4,Weight=2400},{Pet=7,Chance=1.499,Weight=1499},{Pet=8,Chance=1,Weight=1000},{Pet=9,Chance=0.1,Weight=100},{Pet=10,Chance=0.001,Weight=1}}},
[2]={Id=2,Name="Blossom Egg",World="island",Cost=150,Position=Vector3.new(71,2,132),Color=Color3.fromRGB(255,155,166),Pool={{Pet=11,Chance=32,Weight=32000},{Pet=12,Chance=30,Weight=30000},{Pet=13,Chance=14,Weight=14000},{Pet=14,Chance=12,Weight=12000},{Pet=15,Chance=7,Weight=7000},{Pet=16,Chance=2.4,Weight=2400},{Pet=17,Chance=1.499,Weight=1499},{Pet=18,Chance=1,Weight=1000},{Pet=19,Chance=0.1,Weight=100},{Pet=20,Chance=0.001,Weight=1}}},
[3]={Id=3,Name="Ancient Egg",World="island",Cost=1000,Position=Vector3.new(102,2,132),Color=Color3.fromRGB(100,205,227),Pool={{Pet=21,Chance=32,Weight=32000},{Pet=22,Chance=30,Weight=30000},{Pet=23,Chance=14,Weight=14000},{Pet=24,Chance=12,Weight=12000},{Pet=25,Chance=7,Weight=7000},{Pet=26,Chance=2.4,Weight=2400},{Pet=27,Chance=1.499,Weight=1499},{Pet=28,Chance=1,Weight=1000},{Pet=29,Chance=0.1,Weight=100},{Pet=30,Chance=0.001,Weight=1}}},
[4]={Id=4,Name="Circuit Egg",World="neon",Cost=2500,Position=Vector3.new(540,2,132),Color=Color3.fromRGB(62,213,255),Pool={{Pet=31,Chance=32,Weight=32000},{Pet=32,Chance=30,Weight=30000},{Pet=33,Chance=14,Weight=14000},{Pet=34,Chance=12,Weight=12000},{Pet=35,Chance=7,Weight=7000},{Pet=36,Chance=2.4,Weight=2400},{Pet=37,Chance=1.499,Weight=1499},{Pet=38,Chance=1,Weight=1000},{Pet=39,Chance=0.1,Weight=100},{Pet=40,Chance=0.001,Weight=1}}},
[5]={Id=5,Name="Plasma Egg",World="neon",Cost=10000,Position=Vector3.new(571,2,132),Color=Color3.fromRGB(195,105,255),Pool={{Pet=41,Chance=32,Weight=32000},{Pet=42,Chance=30,Weight=30000},{Pet=43,Chance=14,Weight=14000},{Pet=44,Chance=12,Weight=12000},{Pet=45,Chance=7,Weight=7000},{Pet=46,Chance=2.4,Weight=2400},{Pet=47,Chance=1.499,Weight=1499},{Pet=48,Chance=1,Weight=1000},{Pet=49,Chance=0.1,Weight=100},{Pet=50,Chance=0.001,Weight=1}}},
[6]={Id=6,Name="Galaxy Egg",World="neon",Cost=50000,Position=Vector3.new(602,2,132),Color=Color3.fromRGB(255,116,207),Pool={{Pet=51,Chance=32,Weight=32000},{Pet=52,Chance=30,Weight=30000},{Pet=53,Chance=14,Weight=14000},{Pet=54,Chance=12,Weight=12000},{Pet=55,Chance=7,Weight=7000},{Pet=56,Chance=2.4,Weight=2400},{Pet=57,Chance=1.499,Weight=1499},{Pet=58,Chance=1,Weight=1000},{Pet=59,Chance=0.1,Weight=100},{Pet=60,Chance=0.001,Weight=1}}},
}
function Config.GetUpgradeCost(level) return Config.FirstUpgradeCost*(level+1) end
function Config.GetWalkSpeed(level) return Config.BaseWalkSpeed+Config.SpeedPerLevel*level end
function Config.GetMagnetRadius(level) return Config.BaseMagnetRadius*(1+Config.MagnetRadiusGrowth)^level end
function Config.GetMagnetUpgradeCost(level) return 5*(level+1) end
function Config.GetIncomeMultiplier(level) return 1+0.25*level end
function Config.GetIncomeUpgradeCost(level) return 15*(level+1) end
function Config.GetPetMultiplier(id) return Config.Pets[id] and Config.Pets[id].Multiplier or 1 end
function Config.RollEgg(eggId,roll)
 local egg=assert(Config.Eggs[eggId],"Unknown egg")
 assert(roll>=1 and roll<=100000 and roll==math.floor(roll),"Roll must be 1..100000")
 local total=0
 for _,entry in ipairs(egg.Pool) do total=total+entry.Weight; if roll<=total then return entry.Pet end end
 error("Egg weights must total 100000")
end
return Config
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX_PET_VISUALS">
<Properties>
<string name="Name">PetVisuals</string>
<ProtectedString name="Source"><![CDATA[-- Sanitized Creator Store meshes take priority; ten rounded fallback species.
local Config=require(script.Parent:WaitForChild("GameConfig"))
local PetVisuals={}
function PetVisuals.Build(id)
 local def=assert(Config.Pets[id],"Unknown pet")
 local library=script.Parent:FindFirstChild("PetAssets")
 if library then
  local templates=library:GetChildren()
  table.sort(templates,function(a,b) return a.Name<b.Name end)
  local selected
  for _,template in ipairs(templates) do if string.find(string.lower(template.Name),def.Visual,1,true) then selected=template;break end end
  selected=selected or templates[(id-1)%math.max(#templates,1)+1]
  if selected and selected:IsA("Model") and selected:FindFirstChildWhichIsA("BasePart",true) then
   local model=selected:Clone();model.Name=def.Name
   local size=model:GetExtentsSize()
   model:ScaleTo(model:GetScale()*2.8/math.max(size.X,size.Y,size.Z,0.1))
   model:PivotTo(CFrame.identity)
   local parts={}
   for _,p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;table.insert(parts,{part=p,transparency=p.Transparency}) end end
   model.PrimaryPart=model.PrimaryPart or parts[1].part
   return model,parts
  end
 end
 local model=Instance.new("Model");model.Name=def.Name
 local parts={}
 local function piece(name,size,pos,color,shape,rotation,material)
  local p=Instance.new(shape=="wedge" and "WedgePart" or "Part")
  p.Name=name;p.Size=size;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
  p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
  if shape=="ball" then p.Shape=Enum.PartType.Ball end
  p.CFrame=CFrame.new(pos)*(rotation or CFrame.identity);p.Parent=model
  table.insert(parts,{part=p,transparency=0});return p
 end
 local c=def.Color
 local cream=c:Lerp(Color3.new(1,1,1),0.73)
 local dark=Color3.fromRGB(28,37,57)
 model.PrimaryPart=piece("Body",Vector3.new(1.65,1.45,1.65),Vector3.zero,c,"ball")
 piece("Face",Vector3.new(1.38,1.06,0.22),Vector3.new(0,0.1,-0.73),cream,"ball")
 for _,side in ipairs({-1,1}) do
  piece("Eye",Vector3.new(0.34,0.43,0.17),Vector3.new(side*0.38,0.27,-0.87),dark,"ball")
  piece("EyeLight",Vector3.new(0.12,0.14,0.065),Vector3.new(side*0.37,0.38,-0.965),Color3.new(1,1,1),"ball")
  piece("Blush",Vector3.new(0.25,0.12,0.08),Vector3.new(side*0.57,-0.03,-0.85),Color3.fromRGB(255,166,184),"ball")
  piece("Paw",Vector3.new(0.46,0.36,0.58),Vector3.new(side*0.55,-0.67,-0.31),cream,"ball")
 end
 piece("Nose",Vector3.new(0.15,0.12,0.1),Vector3.new(0,0.02,-0.93),dark,"ball")
 local kind=def.Visual
 if kind=="bunny" then
  for _,side in ipairs({-1,1}) do
   piece("LongEar",Vector3.new(0.46,1.35,0.48),Vector3.new(side*0.43,1.16,0),c,"ball",CFrame.Angles(0,0,-side*0.12))
   piece("InnerEar",Vector3.new(0.23,0.98,0.1),Vector3.new(side*0.43,1.2,-0.22),cream,"ball")
  end
 elseif kind=="dog" then
  for _,side in ipairs({-1,1}) do piece("FloppyEar",Vector3.new(0.5,1,0.55),Vector3.new(side*0.83,0.32,0),c:Lerp(dark,0.2),"ball") end
 elseif kind=="owl" or kind=="phoenix" then
  for _,side in ipairs({-1,1}) do piece("Wing",Vector3.new(0.5,1.1,0.85),Vector3.new(side*0.9,0.04,0.12),c,"ball",CFrame.Angles(0,0,side*0.35)) end
  piece("Beak",Vector3.new(0.35,0.35,0.38),Vector3.new(0,0,-1),Color3.fromRGB(255,196,85),"wedge")
  if kind=="phoenix" then for i=1,5 do piece("TailFeather",Vector3.new(0.32,0.45,1.5),Vector3.new((i-3)*0.22,-0.2,1),c:Lerp(Color3.fromRGB(255,214,89),i/7),"ball",CFrame.Angles(0,(i-3)*0.2,0),Enum.Material.Neon) end end
 elseif kind=="dragon" then
  for _,side in ipairs({-1,1}) do
   piece("Wing",Vector3.new(1.3,0.22,1.4),Vector3.new(side*1.08,0.4,0.45),cream,"wedge",CFrame.Angles(0,side*0.3,side*0.45))
   piece("Horn",Vector3.new(0.27,0.7,0.3),Vector3.new(side*0.5,0.95,0),cream,"wedge")
  end
  piece("Tail",Vector3.new(0.45,0.45,1.25),Vector3.new(0,-0.1,1.1),c,"ball")
 elseif kind=="deer" then
  for _,side in ipairs({-1,1}) do
   piece("Antler",Vector3.new(0.15,1,0.15),Vector3.new(side*0.5,1.1,0.1),Color3.fromRGB(219,181,112),nil,CFrame.Angles(0,0,-side*0.25))
   piece("AntlerBranch",Vector3.new(0.55,0.13,0.13),Vector3.new(side*0.58,1.3,0.1),Color3.fromRGB(219,181,112))
  end
 elseif kind=="lion" then
  for i=1,10 do local a=i/10*math.pi*2;piece("Mane",Vector3.new(0.65,0.65,0.6),Vector3.new(math.cos(a)*0.82,math.sin(a)*0.78,-0.1),c:Lerp(Color3.fromRGB(255,187,65),0.6),"ball") end
 elseif kind=="spirit" then
  for i=1,5 do local a=i/5*math.pi*2;piece("OrbitGem",Vector3.new(0.3,0.5,0.3),Vector3.new(math.cos(a)*1.1,0.8,math.sin(a)*1.1),cream,"ball",nil,Enum.Material.Neon) end
 else
  for _,side in ipairs({-1,1}) do piece("Ear",Vector3.new(0.55,0.7,0.5),Vector3.new(side*0.55,0.8,0),c,"wedge",CFrame.Angles(0,0,-side*0.15)) end
  if kind=="fox" then piece("FluffyTail",Vector3.new(0.85,0.8,1.5),Vector3.new(0,0,1),cream,"ball",CFrame.Angles(0.35,0,0)) end
 end
 return model,parts
end
return PetVisuals
]]></ProtectedString>
</Properties>

</Item>
</Item>
<Item class="ServerScriptService" referent="RBX_SERVER_SCRIPT_SERVICE">
<Properties>
<string name="Name">ServerScriptService</string>

</Properties>
<Item class="Script" referent="RBX_GAME_SERVER">
<Properties>
<string name="Name">GameServer</string>
<ProtectedString name="Source"><![CDATA[-- Script в ServerScriptService. Все награды и покупки проверяет сервер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local world = workspace:WaitForChild("CoinSpeedWorld")
if world:GetAttribute("ServerRunning") then return end
world:SetAttribute("ServerRunning", true)
local city = world:WaitForChild("NeonCity")
workspace.GlobalWind=Vector3.new(8,0,3)
workspace.Terrain:FillBlock(CFrame.new(0,-6,0),Vector3.new(300,12,460),Enum.Material.Grass)
workspace.Terrain:FillBlock(CFrame.new(-95,-2,-30),Vector3.new(48,4,56),Enum.Material.Water)
local feedback = Instance.new("RemoteEvent")
feedback.Name = "GameFeedback"
feedback.Parent = ReplicatedStorage
local cooldown = {}
local hatchUntil = {}
local random = Random.new()
local openMenu = Instance.new("RemoteEvent")
openMenu.Name = "GameShopOpen"
openMenu.Parent = ReplicatedStorage
local buy = Instance.new("RemoteEvent")
buy.Name = "GameShopBuy"
buy.Parent = ReplicatedStorage
local hatched = Instance.new("RemoteEvent")
hatched.Name = "GameHatched"
hatched.Parent = ReplicatedStorage
local function alive(player)
 local character = player.Character
 if not character then return end
 local h = character:FindFirstChildOfClass("Humanoid")
 local root = character:FindFirstChild("HumanoidRootPart")
 if h and root and h.Health > 0 then return h, root end
end
local function setup(player)
 if player:FindFirstChild("leaderstats") then return end
 player:SetAttribute("ProfileReady",false)
 player:SetAttribute("MagnetLevel", 0)
 player:SetAttribute("PetLevel", 0)
 player:SetAttribute("IncomeLevel", 0)
 player:SetAttribute("LifetimeEarned", 0)
 player:SetAttribute("CoinsCollected", 0)
 player:SetAttribute("EggsOpened", 0)
 for i=1,#Config.Pets do player:SetAttribute("PetOwned" .. i, 0) end
 player:SetAttribute("CurrentWorld", "Meadow Isles")
 local stats = Instance.new("Folder")
 stats.Name = "leaderstats"
 local coins = Instance.new("NumberValue") -- Поддерживает 7.5 монеты при множителе x1.5.
 coins.Name = "Coins"
 coins.Parent = stats
 local level = Instance.new("IntValue")
 level.Name = "SpeedLevel"
 level.Parent = stats
 stats.Parent = player
 player.RespawnLocation = world.Start
 local function characterAdded(character)
  local h = character:WaitForChild("Humanoid", 10)
  if h and player.Character == character then h.WalkSpeed = Config.GetWalkSpeed(level.Value) end
  player:SetAttribute("CurrentWorld", "Meadow Isles")
 end
 player.CharacterAdded:Connect(characterAdded)
 if player.Character then task.spawn(characterAdded, player.Character) end
end
Players.PlayerAdded:Connect(setup)
Players.PlayerRemoving:Connect(function(p) cooldown[p] = nil; hatchUntil[p] = nil end)
for _, p in ipairs(Players:GetPlayers()) do setup(p) end

local function notify(p, text, success) feedback:FireClient(p, text, success or false) end
local function interact(p, part, prompt, cityOnly)
 if p.Parent ~= Players or not prompt.Enabled then return end
 if not p:GetAttribute("ProfileReady") then return end
 local h, root = alive(p)
 if not h or (root.Position - part.Position).Magnitude > Config.ShopDistance then return end
 local stats = p:FindFirstChild("leaderstats")
 if not stats then return end
 if cityOnly and stats.SpeedLevel.Value < 3 then return end
 local now = os.clock()
 if now - (cooldown[p] or -math.huge) < Config.PurchaseCooldown then return end
 cooldown[p] = now
 return stats, h, root
end
-- Открытие меню не списывает деньги. Каждая покупка снова проверяет расстояние.
local zones = {island=world, neon=city}
local function shopPart(zone, mode, eggId)
 if mode == "egg" then
  local egg=Config.Eggs[eggId]
  if not egg or (egg.World=="neon")~=(zone==city) then return end
  local stand=zone:FindFirstChild("EggStand"..eggId)
  if not stand then return end
  return stand.Interact,stand.Interact.OpenEggMenu
 end
 return zone.UpgradeShop.Counter, zone.UpgradeShop.Counter.OpenShop
end
for id,zone in pairs(zones) do
 local part,prompt=shopPart(zone,"upgrades")
 prompt.Triggered:Connect(function(p)
  if interact(p,part,prompt,zone==city) then openMenu:FireClient(p,"upgrades",id) end
 end)
 for eggId,egg in ipairs(Config.Eggs) do
  if egg.World==id then
   local eggPart,eggPrompt=shopPart(zone,"egg",eggId)
   eggPrompt.Triggered:Connect(function(p)
    if interact(p,eggPart,eggPrompt,zone==city) then openMenu:FireClient(p,"egg",id,eggId) end
   end)
  end
 end
end
buy.OnServerEvent:Connect(function(p, kind, zoneId, eggId)
 if type(kind) ~= "string" or type(zoneId) ~= "string" then return end
 if kind ~= "speed" and kind ~= "magnet" and kind ~= "income" and kind ~= "egg" then return end
 local zone = zones[zoneId]
 if not zone then return end
 if kind=="egg" and (type(eggId)~="number" or eggId~=math.floor(eggId)) then return end
 local part, prompt = shopPart(zone, kind == "egg" and "egg" or "upgrades",eggId)
 if not part then return end
 local stats, h = interact(p, part, prompt, zone == city)
 if not stats then return end
 local value, cost
 if kind == "speed" then
  value = stats.SpeedLevel.Value
  if value >= Config.MaxSpeedLevel then notify(p,"Speed is maxed!"); return end
  cost = Config.GetUpgradeCost(value)
 elseif kind == "magnet" then
  value = p:GetAttribute("MagnetLevel") or 0
  if value >= Config.MaxMagnetLevel then notify(p,"Magnet is maxed!"); return end
  cost = Config.GetMagnetUpgradeCost(value)
 elseif kind == "income" then
  value = p:GetAttribute("IncomeLevel") or 0
  if value >= Config.MaxIncomeLevel then notify(p,"Income is maxed!"); return end
  cost = Config.GetIncomeUpgradeCost(value)
 else
  if os.clock() < (hatchUntil[p] or 0) then return end
  cost = Config.Eggs[eggId].Cost
 end
 if stats.Coins.Value < cost then notify(p,"Not enough coins. Need " .. string.format("%g",cost-stats.Coins.Value)); return end
 stats.Coins.Value = stats.Coins.Value - cost
 if kind == "speed" then
  stats.SpeedLevel.Value = value+1
  h.WalkSpeed = Config.GetWalkSpeed(value+1)
  notify(p,"Speed: " .. h.WalkSpeed,true)
 elseif kind == "magnet" then
  p:SetAttribute("MagnetLevel",value+1)
  notify(p,string.format("Magnet radius: %.2f",Config.GetMagnetRadius(value+1)),true)
 elseif kind == "income" then
  p:SetAttribute("IncomeLevel",value+1)
  notify(p,"Income: x" .. Config.GetIncomeMultiplier(value+1),true)
 else
  hatchUntil[p] = os.clock()+3.5
  local result=Config.RollEgg(eggId,random:NextInteger(1,100000))
  local attribute = "PetOwned" .. result
  local count = (p:GetAttribute(attribute) or 0)+1
  p:SetAttribute(attribute,count)
  -- Автоматически сопровождает самый сильный из открытых питомцев.
  if Config.GetPetMultiplier(result)>Config.GetPetMultiplier(p:GetAttribute("PetLevel") or 0) then p:SetAttribute("PetLevel",result) end
  p:SetAttribute("EggsOpened",(p:GetAttribute("EggsOpened") or 0)+1)
  hatched:FireClient(p,result,count,eggId)
 end
end)

-- Загружаем именно аватар владельца; при ошибке сети остаётся видимый манекен.
task.spawn(function()
 local ok, avatar = pcall(function() return Players:CreateHumanoidModelFromUserIdAsync(Config.ShopkeeperUserId) end)
 if not ok then warn("[CoinSprint] Не удалось загрузить аватар продавца: " .. tostring(avatar)); return end
 for _, zone in pairs(zones) do
  local shop = zone.UpgradeShop
  local npc = avatar:Clone()
  npc.Name = "Shopkeeper"
  local root=npc:FindFirstChild("HumanoidRootPart")
  for _,part in ipairs(npc:GetDescendants()) do
   if part:IsA("BasePart") then
    part.Anchored=part==root;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true
   end
  end
  local humanoid=npc:FindFirstChildOfClass("Humanoid")
  if humanoid then humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;humanoid.AutoRotate=false end
  npc.Parent=shop
  local anchor=shop.VendorAnchor.Position
  npc:PivotTo(CFrame.new(anchor.X,anchor.Y+3,anchor.Z)*CFrame.Angles(0,math.pi,0))
  game:GetService("RunService").Heartbeat:Wait()
  local lowest=math.huge
  for _,name in ipairs({"LeftFoot","RightFoot","Left Leg","Right Leg"}) do
   local foot=npc:FindFirstChild(name)
   if foot then lowest=math.min(lowest,foot.Position.Y-foot.Size.Y/2) end
  end
  if lowest<math.huge then npc:PivotTo(npc:GetPivot()+Vector3.new(0,anchor.Y-lowest,0)) end
  local placeholder = shop:FindFirstChild("VendorPlaceholder")
  if placeholder then placeholder:Destroy() end
 end
 avatar:Destroy()
end)
local function portal(zone, name, target, needsLevel, destination)
 local part = zone:WaitForChild(name)
 local prompt = part:WaitForChild("EnterWorld")
 prompt.Triggered:Connect(function(p)
  local stats, _, root = interact(p, part, prompt, false)
  if not stats then return end
  if stats.SpeedLevel.Value < needsLevel then notify(p, "Requires speed 28 · buy 3 speed upgrades."); return end
  p.Character:PivotTo(CFrame.new(target))
  root.AssemblyLinearVelocity = Vector3.zero
  p:SetAttribute("CurrentWorld", destination)
  notify(p, "World: " .. destination, true)
 end)
end
portal(world, "PortalToNeon", Vector3.new(500, 3, 180), 3, "Neon District")
portal(city, "PortalToIsland", Vector3.new(0, 3, 180), 0, "Meadow Isles")

-- У каждой монеты одно серверное состояние для всех игроков.
local records = {}
for _, zone in ipairs({world, city}) do
 for _, coin in ipairs(zone:GetChildren()) do
  if coin:IsA("BasePart") and string.match(coin.Name, "^Coin_%d+$") then
   local record = {part = coin, available = true, value = zone == city and 25 or 5, required = zone == city and 3 or 0}
   table.insert(records, record)
   coin.CanCollide = false
   coin.CanTouch = false
   coin:SetAttribute("Available", true)
  end
 end
end
local function collect(record, p)
 if not record.available then return end
 local stats = p:FindFirstChild("leaderstats")
 if not stats then return end
 record.available = false
 record.part:SetAttribute("Available", false)
 record.part.Transparency = 1
 local label = record.part:FindFirstChild("GameLabel")
 if label then label.Enabled = false end
 local earned=record.value*Config.GetPetMultiplier(p:GetAttribute("PetLevel") or 0)*Config.GetIncomeMultiplier(p:GetAttribute("IncomeLevel") or 0)
 stats.Coins.Value=stats.Coins.Value+earned
 p:SetAttribute("LifetimeEarned",(p:GetAttribute("LifetimeEarned") or 0)+earned)
 p:SetAttribute("CoinsCollected",(p:GetAttribute("CoinsCollected") or 0)+1)
 task.delay(Config.CoinRespawnSeconds, function()
  if record.part.Parent then
   record.part.Transparency = 0
   if label then label.Enabled = true end
   record.available = true
   record.part:SetAttribute("Available", true)
  end
 end)
end
task.spawn(function()
 while world.Parent do
  local candidates = {}
  for _, p in ipairs(Players:GetPlayers()) do
   local h, root = alive(p)
   local stats = p:FindFirstChild("leaderstats")
   if h and stats and p:GetAttribute("ProfileReady") then
    table.insert(candidates, {p=p, root=root, level=stats.SpeedLevel.Value, radius=Config.GetMagnetRadius(p:GetAttribute("MagnetLevel") or 0)})
    if math.abs(root.Position.Z) <= 230 then
     if math.abs(root.Position.X) <= 150 then p:SetAttribute("CurrentWorld", "Meadow Isles")
     elseif math.abs(root.Position.X - 500) <= 150 then p:SetAttribute("CurrentWorld", "Neon District") end
    end
   end
  end
  for _, record in ipairs(records) do
   if record.available and record.part.Parent then
    local nearest, nearestDistance
    for _, candidate in ipairs(candidates) do
     local delta = candidate.root.Position - record.part.Position
     local distance = delta.X * delta.X + delta.Z * delta.Z
     if candidate.level >= record.required and math.abs(delta.Y) <= 6 and distance <= candidate.radius ^ 2 and (not nearestDistance or distance < nearestDistance) then
      nearest, nearestDistance = candidate.p, distance
     end
    end
    if nearest then collect(record, nearest) end
   end
  end
  task.wait(0.1)
 end
end)
print("[CoinSprint] Ready: 2 worlds, 30 coins, pets, magnet, server purchases")
]]></ProtectedString>
</Properties>

</Item>
<Item class="Script" referent="RBX_WORLD_PROGRESS">
<Properties>
<string name="Name">WorldProgress</string>
<ProtectedString name="Source"><![CDATA[-- Published games save profiles and global top-100. Local Studio uses server rankings.
local Players=game:GetService("Players")
local DS=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local Config=require(game.ReplicatedStorage:WaitForChild("GameConfig"))
local world=workspace:WaitForChild("CoinSpeedWorld")
local persistent=game.GameId>0 and (not RunService:IsStudio() or Config.EnableStudioDataStores)
local store=persistent and DS:GetDataStore("CoinSprint_Profiles_V3")
local sessions={}
local token=game.JobId~="" and game.JobId or game:GetService("HttpService"):GenerateGUID(false)
local function number(v) return type(v)=="number" and v==v and math.abs(v)<1e15 and math.max(0,v) or 0 end
local function snapshot(p)
 local data={Coins=p.leaderstats.Coins.Value,Speed=p.leaderstats.SpeedLevel.Value,Owned={}}
 for _,name in ipairs({"MagnetLevel","IncomeLevel","PetLevel","LifetimeEarned","CoinsCollected","EggsOpened"}) do data[name]=p:GetAttribute(name) or 0 end
 for i=1,#Config.Pets do data.Owned[tostring(i)]=p:GetAttribute("PetOwned"..i) or 0 end
 return data
end
local function load(p)
 local stats=p:WaitForChild("leaderstats",20)
 if not stats then return end
 if not persistent then p:SetAttribute("ProfileReady",true);p:SetAttribute("SaveStatus","SESSION ONLY");return end
 local loaded
 for attempt=1,4 do
  local ok,data=pcall(function()
   return store:UpdateAsync(tostring(p.UserId),function(old)
    old=type(old)=="table" and old or {}
    if old.Session and old.Session~=token and os.time()-(old.Lease or 0)<180 then return nil end
    old.Session=token;old.Lease=os.time();return old
   end)
  end)
  if ok and data and data.Session==token then loaded=data;break end
  task.wait(attempt*2)
 end
 if not loaded then p:Kick("Your profile is unavailable or still open on another server. Please rejoin shortly.");return end
 sessions[p]={busy=false,release=false}
 stats.Coins.Value=number(loaded.Coins)
 stats.SpeedLevel.Value=math.clamp(math.floor(number(loaded.Speed)),0,Config.MaxSpeedLevel)
 p:SetAttribute("MagnetLevel",math.clamp(math.floor(number(loaded.MagnetLevel)),0,Config.MaxMagnetLevel))
 p:SetAttribute("IncomeLevel",math.clamp(math.floor(number(loaded.IncomeLevel)),0,Config.MaxIncomeLevel))
 for _,name in ipairs({"LifetimeEarned","CoinsCollected","EggsOpened"}) do p:SetAttribute(name,number(loaded[name])) end
 local best=0
 for i=1,#Config.Pets do
  local count=math.floor(number(type(loaded.Owned)=="table" and loaded.Owned[tostring(i)]))
  p:SetAttribute("PetOwned"..i,count)
  if count>0 and Config.GetPetMultiplier(i)>Config.GetPetMultiplier(best) then best=i end
 end
 p:SetAttribute("PetLevel",best)
 local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
 if h then h.WalkSpeed=Config.GetWalkSpeed(stats.SpeedLevel.Value) end
 p:SetAttribute("ProfileReady",true);p:SetAttribute("SaveStatus","SAVING ENABLED")
end
local function save(p,release)
 local session=sessions[p]
 if not session then return end
 session.release=session.release or release
 if session.busy then if not release then return end;repeat task.wait(0.1) until not session.busy end
 session.busy=true
 local data=snapshot(p)
 if session.release then data.Session=nil else data.Session=token end
 data.Lease=os.time()
 local ok,err=pcall(function()
  store:UpdateAsync(tostring(p.UserId),function(old)
   if type(old)~="table" or old.Session~=token then return nil end
   return data
  end)
 end)
 session.busy=false
 if not ok then warn("[Profiles] Save failed: "..tostring(err));p:SetAttribute("SaveStatus","SAVE RETRY PENDING") end
 if session.release and ok then sessions[p]=nil end
end
Players.PlayerAdded:Connect(function(p) task.spawn(load,p) end)
Players.PlayerRemoving:Connect(function(p) save(p,true) end)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(load,p) end
task.spawn(function() while true do task.wait(60);for p in pairs(sessions) do task.spawn(save,p,false) end end end)
game:BindToClose(function()
 if not persistent then return end
 for p in pairs(sessions) do task.spawn(save,p,true) end
 local deadline=os.clock()+25
 while next(sessions) and os.clock()<deadline do task.wait(0.2) end
end)
local defs={{Part="BoardCoins",Title="TOP 100 · COINS",Stat="LifetimeEarned",Scale=100},{Part="BoardEggs",Title="TOP 100 · EGGS",Stat="EggsOpened",Scale=1},{Part="BoardPickups",Title="TOP 100 · PICKUPS",Stat="CoinsCollected",Scale=1}}
local names={}
local function label(parent,text,pos,size,fontSize,color)
 local x=Instance.new("TextLabel")
 x.BackgroundTransparency=1;x.Position=pos;x.Size=size;x.Text=text
 x.Font=Enum.Font.GothamBold;x.TextSize=fontSize;x.TextColor3=color or Color3.fromRGB(239,245,232);x.Parent=parent;return x
end
for _,def in ipairs(defs) do
 local gui=Instance.new("SurfaceGui")
 gui.Name="Rankings";gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(860,360);gui.MaxDistance=130;gui.Active=true;gui.Parent=world:WaitForChild(def.Part)
 label(gui,def.Title,UDim2.fromOffset(0,8),UDim2.fromOffset(860,45),32,Color3.fromRGB(255,220,133))
 def.subtitle=label(gui,persistent and "GLOBAL · refreshes every 120s" or "THIS SERVER · publish for global rankings",UDim2.fromOffset(0,55),UDim2.fromOffset(860,30),18)
 local list=Instance.new("ScrollingFrame")
 list.Position=UDim2.fromOffset(25,95);list.Size=UDim2.fromOffset(810,250);list.BackgroundTransparency=1;list.BorderSizePixel=0;list.ScrollBarThickness=8;list.Parent=gui;def.list=list
 if persistent then def.store=DS:GetOrderedDataStore("CoinSprint_TopV3_"..def.Stat) end
end
local function render(def,rows)
 def.list:ClearAllChildren();def.list.CanvasSize=UDim2.fromOffset(0,math.max(250,#rows*32))
 if #rows==0 then label(def.list,"Be the first on this board!",UDim2.fromOffset(0,50),UDim2.fromOffset(780,40),23);return end
 for i,row in ipairs(rows) do
  label(def.list,string.format("#%d   %s",i,row.Name),UDim2.fromOffset(8,(i-1)*32),UDim2.fromOffset(560,30),21).TextXAlignment=Enum.TextXAlignment.Left
  label(def.list,string.format("%g",row.Value),UDim2.fromOffset(570,(i-1)*32),UDim2.fromOffset(200,30),21).TextXAlignment=Enum.TextXAlignment.Right
 end
end
local function refresh()
 for _,def in ipairs(defs) do
  local rows={}
  for _,p in ipairs(Players:GetPlayers()) do
   table.insert(rows,{Name=p.DisplayName,Value=p:GetAttribute(def.Stat) or 0})
   if def.store and p:GetAttribute("ProfileReady") then pcall(function() def.store:UpdateAsync(tostring(p.UserId),function(old) return math.max(old or 0,math.floor((p:GetAttribute(def.Stat) or 0)*def.Scale)) end) end) end
  end
  table.sort(rows,function(a,b) return a.Value>b.Value end)
  if def.store then
   local ok,pages=pcall(function() return def.store:GetSortedAsync(false,100) end)
   if ok then
    rows={}
    for _,entry in ipairs(pages:GetCurrentPage()) do
     local id=tonumber(entry.key)
     local name=names[id]
     if not name then local success,result=pcall(function() return Players:GetNameFromUserIdAsync(id) end);name=success and result or ("User "..entry.key);names[id]=name end
     table.insert(rows,{Name=name,Value=entry.value/def.Scale})
    end
    def.subtitle.Text="GLOBAL · refreshes every 120s"
   else def.subtitle.Text="THIS SERVER · global service unavailable" end
  end
  render(def,rows)
 end
end
task.spawn(function() while true do refresh();task.wait(persistent and 120 or 8) end end)
]]></ProtectedString>
</Properties>

</Item>
</Item>
<Item class="StarterPlayer" referent="RBX_STARTER_PLAYER">
<Properties>
<string name="Name">StarterPlayer</string>

</Properties>
<Item class="StarterPlayerScripts" referent="RBX_STARTER_PLAYER_SCRIPTS">
<Properties>
<string name="Name">StarterPlayerScripts</string>

</Properties>
<Item class="LocalScript" referent="RBX_GAME_HUD">
<Properties>
<string name="Name">GameHUD</string>
<ProtectedString name="Source"><![CDATA[-- Minimal launchers. Detailed statistics are visible only on demand.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local StarterGui=game:GetService("StarterGui")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local Config=require(ReplicatedStorage:WaitForChild("GameConfig"))
local stats=player:WaitForChild("leaderstats")
local gui=Instance.new("ScreenGui");gui.Name="CoinSprintHUD";gui.ResetOnSpawn=false;gui.DisplayOrder=12;gui.Parent=player:WaitForChild("PlayerGui")
local openIndex=Instance.new("BindableEvent");openIndex.Name="OpenPetIndex";openIndex.Parent=player.PlayerGui
local function button(parent,text,size,pos)
 local b=Instance.new("TextButton");b.Size=size;b.Position=pos;b.Text=text;b.Font=Enum.Font.GothamBold;b.TextSize=14;b.TextColor3=Color3.fromRGB(244,247,240);b.BackgroundColor3=Color3.fromRGB(35,55,54);b.BackgroundTransparency=0.15;b.Parent=parent;Instance.new("UICorner",b).CornerRadius=UDim.new(0,12);return b
end
local bar=Instance.new("Frame");bar.Size=UDim2.fromOffset(208,36);bar.AnchorPoint=Vector2.new(0.5,1);bar.Position=UDim2.new(0.5,0,1,-14);bar.BackgroundTransparency=1;bar.Parent=gui
local statButton=button(bar,"STATS",UDim2.fromOffset(98,36),UDim2.fromOffset(0,0))
local indexButton=button(bar,"PET INDEX",UDim2.fromOffset(98,36),UDim2.fromOffset(110,0))
local panel=Instance.new("Frame");panel.Name="Statistics";panel.AnchorPoint=Vector2.new(0.5,0.5);panel.Position=UDim2.fromScale(0.5,0.5);panel.Size=UDim2.fromOffset(420,405);panel.BackgroundColor3=Color3.fromRGB(24,42,42);panel.Visible=false;panel.Parent=gui;Instance.new("UICorner",panel).CornerRadius=UDim.new(0,20)
local scale=Instance.new("UIScale",panel)
local title=Instance.new("TextLabel");title.Size=UDim2.new(1,-60,0,48);title.Position=UDim2.fromOffset(16,8);title.Text="YOUR STATISTICS";title.Font=Enum.Font.GothamBold;title.TextSize=22;title.TextColor3=Color3.fromRGB(244,230,191);title.BackgroundTransparency=1;title.Parent=panel
local close=button(panel,"×",UDim2.fromOffset(34,34),UDim2.fromOffset(374,12));close.Modal=true
local content=Instance.new("TextLabel");content.Position=UDim2.fromOffset(26,65);content.Size=UDim2.fromOffset(370,255);content.TextXAlignment=Enum.TextXAlignment.Left;content.TextYAlignment=Enum.TextYAlignment.Top;content.Font=Enum.Font.GothamMedium;content.TextSize=17;content.TextColor3=Color3.fromRGB(224,238,225);content.BackgroundTransparency=1;content.Parent=panel
local range=button(panel,"Magnet range: OFF",UDim2.fromOffset(368,38),UDim2.fromOffset(26,332))
player:SetAttribute("ShowMagnetRange",false)
range.Activated:Connect(function() local visible=not player:GetAttribute("ShowMagnetRange");player:SetAttribute("ShowMagnetRange",visible);range.Text="Magnet range: "..(visible and "ON" or "OFF") end)
local function hide() panel.Visible=false;if player:GetAttribute("UIScreen")=="stats" then player:SetAttribute("UIScreen","") end end
close.Activated:Connect(hide)
statButton.Activated:Connect(function() if panel.Visible then hide() else player:SetAttribute("UIScreen","stats");panel.Visible=true end end)
indexButton.Activated:Connect(function() hide();openIndex:Fire() end)
player:GetAttributeChangedSignal("UIScreen"):Connect(function() if player:GetAttribute("UIScreen")~="stats" then panel.Visible=false end end)
local function update()
 local pet=Config.Pets[player:GetAttribute("PetLevel") or 0]
 local owned=0
 for i=1,#Config.Pets do if (player:GetAttribute("PetOwned"..i) or 0)>0 then owned=owned+1 end end
 content.Text=string.format("Coins                  %g\nSpeed                  %d  (level %d)\nMagnet radius      %.2f\nIncome                 x%g\nBest pet               %s\nPet bonus             x%g\nEggs opened        %d\nCoins picked up   %d\nPet index              %d / %d\n%s",stats.Coins.Value,Config.GetWalkSpeed(stats.SpeedLevel.Value),stats.SpeedLevel.Value,Config.GetMagnetRadius(player:GetAttribute("MagnetLevel") or 0),Config.GetIncomeMultiplier(player:GetAttribute("IncomeLevel") or 0),pet and pet.Name or "None",Config.GetPetMultiplier(player:GetAttribute("PetLevel") or 0),player:GetAttribute("EggsOpened") or 0,player:GetAttribute("CoinsCollected") or 0,owned,#Config.Pets,player:GetAttribute("SaveStatus") or "LOADING PROFILE")
end
stats.Coins.Changed:Connect(update);stats.SpeedLevel.Changed:Connect(update);player.AttributeChanged:Connect(update);update()
local toast=Instance.new("TextLabel");toast.AnchorPoint=Vector2.new(0.5,1);toast.Position=UDim2.new(0.5,0,1,-64);toast.Size=UDim2.new(0.7,0,0,38);toast.BackgroundColor3=Color3.fromRGB(30,47,50);toast.BackgroundTransparency=0.08;toast.TextColor3=Color3.fromRGB(243,235,207);toast.TextWrapped=true;toast.Font=Enum.Font.GothamBold;toast.TextSize=16;toast.Visible=false;toast.Parent=gui;Instance.new("UICorner",toast).CornerRadius=UDim.new(0,10)
local version=0
ReplicatedStorage:WaitForChild("GameFeedback").OnClientEvent:Connect(function(message) version=version+1;local current=version;toast.Text=message;toast.Visible=true;task.delay(2.8,function() if version==current then toast.Visible=false end end) end)
local hidden=false
local previous=true
RunService.RenderStepped:Connect(function()
 local camera=workspace.CurrentCamera
 if camera then scale.Scale=math.clamp(math.min(camera.ViewportSize.X/450,camera.ViewportSize.Y/460),0.3,1) end
 local modal=(player:GetAttribute("UIScreen") or "")~=""
 if modal and not hidden then local ok,value=pcall(function() return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.PlayerList) end);previous=not ok or value;pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end);hidden=true
 elseif not modal and hidden then pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,previous) end);hidden=false end
end)
gui.Destroying:Connect(function() if hidden then pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,previous) end) end end)
]]></ProtectedString>
</Properties>

</Item>
<Item class="LocalScript" referent="RBX_GAME_EFFECTS">
<Properties>
<string name="Name">GameEffects</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript в StarterPlayer > StarterPlayerScripts.
-- Только оформление: питомцы и кольцо магнита. Денег и наград здесь нет.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local localPlayer = Players.LocalPlayer
local PetVisuals = require(ReplicatedStorage:WaitForChild("PetVisuals"))

if type(Config.Pets) ~= "table"
	or type(Config.GetPetMultiplier) ~= "function"
	or type(Config.GetMagnetRadius) ~= "function" then
	warn("[CoinSprint] GameEffects: обновите GameConfig для питомцев и магнита.")
	return
end

-- Объекты, созданные LocalScript, видны только на этом компьютере.
-- Каждый клиент сам рисует питомцев всех игроков по их атрибутам.
local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "CoinSprintClientFX"
effectsFolder.Parent = Workspace

local records = {}
local connections = {}
local stopped = false
local offscreen = CFrame.new(0, -10000, 0)

local function getPetLevel(player)
	local value = player:GetAttribute("PetLevel")
	if type(value) ~= "number" then
		return 0
	end
	return math.clamp(math.floor(value), 0, #Config.Pets)
end

local function getMagnetLevel()
	local value = localPlayer:GetAttribute("MagnetLevel")
	return type(value) == "number" and math.max(0, math.floor(value)) or 0
end

local function setPetVisible(record, visible)
	if record.visible == visible then
		return
	end
	record.visible = visible
	for _, entry in ipairs(record.parts) do
		if entry.part.Parent then
			entry.part.Transparency = visible and entry.transparency or 1
		end
	end
	if record.billboard then
		record.billboard.Enabled = visible
	end
end

local function refreshPet(record)
	local level = getPetLevel(record.player)
	if level == record.level then
		return
	end
	if record.model then
		record.model:Destroy()
	end
	record.level = level
	record.model = nil
	record.billboard = nil
	record.parts = {}
	record.frame = nil
	record.visible = false
	if level == 0 then
		return
	end

	local definition = Config.Pets[level]
	local model, parts = PetVisuals.Build(level)
	model.Name = "Pet_" .. record.player.UserId
	model.Parent = effectsFolder
	record.model = model
	record.parts = parts
	local body = model.PrimaryPart
	for _,entry in ipairs(parts) do entry.part.Transparency = 1 end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PetName"
	billboard.Size = UDim2.fromOffset(170, 28)
	billboard.StudsOffset = Vector3.new(0, 2.2, 0)
	billboard.MaxDistance = 45
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Parent = body
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextSize = 13
	text.TextColor3 = Color3.fromRGB(255, 248, 229)
	text.TextStrokeTransparency = 0.25
	text.Text = definition.Name .. "  x" .. string.format("%g", Config.GetPetMultiplier(level))
	text.Parent = billboard
	record.billboard = billboard
end

-- Кольцо лежит чуть выше поверхности, чтобы не мерцать внутри пола.
local ring = Instance.new("Model")
ring.Name = "LocalMagnetRadius"
ring.Parent = effectsFolder
local ringSegments = {}
local ringVisible = false
local ringRadius = -1
local segmentCount = 24
local segmentAngle = math.pi * 2 / segmentCount
for index = 1, segmentCount do
	local angleA = (index - 1) * segmentAngle
	local angleB = index * segmentAngle
	local a = Vector3.new(math.cos(angleA), 0, math.sin(angleA))
	local b = Vector3.new(math.cos(angleB), 0, math.sin(angleB))
	local part = Instance.new("Part")
	part.Name = "RingSegment"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(191, 114, 255)
	part.Size = Vector3.new(0.1, 0.07, 0.5)
	part.Transparency = 1
	part.CFrame = offscreen
	part.Parent = ring
	table.insert(ringSegments, {
		part = part,
		middle = (a + b) / 2,
		rotation = CFrame.lookAt(Vector3.zero, b - a),
	})
end

local function setRingVisible(visible)
	if ringVisible == visible then
		return
	end
	ringVisible = visible
	for _, segment in ipairs(ringSegments) do
		segment.part.Transparency = visible and 0.86 or 1
	end
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true
local function refreshRaycastFilter()
	local excluded = { effectsFolder }
	for player in pairs(records) do
		if player.Character then
			table.insert(excluded, player.Character)
		end
	end
	raycastParams.FilterDescendantsInstances = excluded
end

local function addPlayer(player)
	if records[player] then
		return
	end
	local record = { player = player, level = -1, parts = {}, connections = {}, visible = false }
	records[player] = record
	table.insert(record.connections, player:GetAttributeChangedSignal("PetLevel"):Connect(function()
		refreshPet(record)
	end))
	table.insert(record.connections, player:GetAttributeChangedSignal("CurrentWorld"):Connect(function()
		record.frame = nil -- Портал: сразу переносим питомца вместе с хозяином.
	end))
	table.insert(record.connections, player.CharacterAdded:Connect(function()
		record.frame = nil
		refreshRaycastFilter()
	end))
	table.insert(record.connections, player.CharacterRemoving:Connect(function()
		setPetVisible(record, false)
		record.frame = nil
		if player == localPlayer then
			setRingVisible(false)
		end
	end))
	refreshPet(record)
	refreshRaycastFilter()
end

local function removePlayer(player)
	local record = records[player]
	if not record then
		return
	end
	for _, connection in ipairs(record.connections) do
		connection:Disconnect()
	end
	if record.model then
		record.model:Destroy()
	end
	records[player] = nil
	refreshRaycastFilter()
end

table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
table.insert(connections, Players.PlayerRemoving:Connect(removePlayer))
for _, player in ipairs(Players:GetPlayers()) do
	addPlayer(player)
end

local elapsed = 0
local ringElapsed = 0
table.insert(connections, RunService.RenderStepped:Connect(function(deltaTime)
	if stopped then
		return
	end
	elapsed = elapsed + deltaTime
	for player, record in pairs(records) do
		if record.model then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not humanoid or humanoid.Health <= 0 or not root then
				setPetVisible(record, false)
				record.frame = nil
			else
				local _, yaw = root.CFrame:ToOrientation()
				local bob = math.sin(elapsed * 3 + player.UserId % 9) * 0.17
				local target = CFrame.new(root.Position)
					* CFrame.Angles(0, yaw, 0)
					* CFrame.new(3, -1.2 + bob, 3)
				if not record.frame or (record.frame.Position - target.Position).Magnitude > 50 then
					record.frame = target
				else
					record.frame = record.frame:Lerp(target, 1 - math.exp(-10 * deltaTime))
				end
				record.model:PivotTo(record.frame)
				setPetVisible(record, true)
			end
		end
	end

	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		setRingVisible(false)
		return
	end

	-- Питомцы следуют каждый кадр, а 48 сегментов кольца достаточно обновлять 30 раз/с.
	ringElapsed = ringElapsed + deltaTime
	if ringElapsed < 1 / 30 and ringVisible then
		return
	end
	ringElapsed = 0
	local ground = Workspace:Raycast(root.Position + Vector3.new(0, 1, 0), Vector3.new(0, -40, 0), raycastParams)
	if not ground then
		setRingVisible(false)
		return
	end
	if not localPlayer:GetAttribute("ShowMagnetRange") then setRingVisible(false); return end
	local radius = Config.GetMagnetRadius(getMagnetLevel())
	local center = Vector3.new(root.Position.X, ground.Position.Y + 0.08, root.Position.Z)
	local chord = 2 * radius * math.sin(segmentAngle / 2) + 0.015
	for _, segment in ipairs(ringSegments) do
		if radius ~= ringRadius then
			segment.part.Size = Vector3.new(0.045, 0.03, chord)
		end
		segment.part.CFrame = CFrame.new(center + segment.middle * radius) * segment.rotation
	end
	ringRadius = radius
	setRingVisible(true)
end))

local function cleanup()
	if stopped then
		return
	end
	stopped = true
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	for player in pairs(records) do
		removePlayer(player)
	end
	effectsFolder:Destroy()
end

script.Destroying:Connect(cleanup)

local nearbyCoins={}
local rootWorld=Workspace:WaitForChild("CoinSpeedWorld")
for _,zone in ipairs({rootWorld,rootWorld:WaitForChild("NeonCity")}) do
 for _,coin in ipairs(zone:GetChildren()) do
  if coin:IsA("BasePart") and string.match(coin.Name,"^Coin_%d+$") then table.insert(nearbyCoins,coin) end
 end
end
task.spawn(function()
 while effectsFolder.Parent do
  local root=localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
  for _,coin in ipairs(nearbyCoins) do
   local label=coin:FindFirstChild("GameLabel")
   if label then label.Enabled=root~=nil and coin:GetAttribute("Available")~=false and (root.Position-coin.Position).Magnitude<12 end
  end
  task.wait(0.12)
 end
end)
]]></ProtectedString>
</Properties>

</Item>
<Item class="LocalScript" referent="RBX_SHOP_UI">
<Properties>
<string name="Name">ShopUI</string>
<ProtectedString name="Source"><![CDATA[-- Proximity egg gallery, searchable-by-egg collection index, and optional upgrade menu.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local Config=require(RS:WaitForChild("GameConfig"))
local PetVisuals=require(RS:WaitForChild("PetVisuals"))
local coins=player:WaitForChild("leaderstats"):WaitForChild("Coins")
local speed=player.leaderstats:WaitForChild("SpeedLevel")
local buy=RS:WaitForChild("GameShopBuy")
local gui=Instance.new("ScreenGui");gui.Name="WorkshopUI";gui.ResetOnSpawn=false;gui.DisplayOrder=20;gui.Parent=player:WaitForChild("PlayerGui")
local function frame(parent,size,pos,color)
 local f=Instance.new("Frame");f.Size=size;f.Position=pos;f.BackgroundColor3=color or Color3.fromRGB(26,40,45);f.BorderSizePixel=0;f.Parent=parent;Instance.new("UICorner",f).CornerRadius=UDim.new(0,16);return f
end
local function text(parent,contents,x,y,w,h,font)
 local t=Instance.new("TextLabel");t.BackgroundTransparency=1;t.Text=contents;t.Position=UDim2.fromOffset(x,y);t.Size=UDim2.fromOffset(w,h);t.Font=Enum.Font.GothamBold;t.TextSize=font or 16;t.TextColor3=Color3.fromRGB(236,244,239);t.TextWrapped=true;t.Parent=parent;return t
end
local function button(parent,contents,x,y,w,h)
 local b=Instance.new("TextButton");b.Text=contents;b.Position=UDim2.fromOffset(x,y);b.Size=UDim2.fromOffset(w,h);b.Font=Enum.Font.GothamBold;b.TextSize=16;b.TextColor3=Color3.fromRGB(245,249,242);b.BackgroundColor3=Color3.fromRGB(72,142,113);b.BorderSizePixel=0;b.Parent=parent;Instance.new("UICorner",b).CornerRadius=UDim.new(0,10);return b
end
local function viewport(parent,x,y,w,h)
 local view=Instance.new("ViewportFrame");view.Position=UDim2.fromOffset(x,y);view.Size=UDim2.fromOffset(w,h);view.BackgroundTransparency=1;view.Ambient=Color3.fromRGB(192,196,210);view.LightColor=Color3.fromRGB(255,248,230);view.LightDirection=Vector3.new(-1,-1,-2);view.Parent=parent
 local camera=Instance.new("Camera");camera.CFrame=CFrame.lookAt(Vector3.new(4,2.8,-6),Vector3.new(0,0.2,0));camera.FieldOfView=38;camera.Parent=view;view.CurrentCamera=camera
 local scene=Instance.new("WorldModel",view);return scene
end
local panel=frame(gui,UDim2.fromOffset(560,445),UDim2.new(1,-22,0.5,0));panel.AnchorPoint=Vector2.new(1,0.5);panel.Visible=false
local scale=Instance.new("UIScale",panel)
local title=text(panel,"",16,12,475,32,22)
local wallet=text(panel,"",16,46,475,24,14)
local close=button(panel,"×",512,12,34,34);close.Modal=true
local gallery=frame(panel,UDim2.fromOffset(532,285),UDim2.fromOffset(14,78));gallery.BackgroundTransparency=1
local detail=text(panel,"Hover a pet to see its rarity and coin multiplier",14,365,532,30,14)
local action=button(panel,"",112,405,335,30)
local previous=button(panel,"‹",16,405,42,30)
local nextPage=button(panel,"›",502,405,42,30)
local upgradePanel=frame(panel,UDim2.fromOffset(532,320),UDim2.fromOffset(14,80));upgradePanel.BackgroundTransparency=1;upgradePanel.Visible=false
local cards={}
for i,entry in ipairs({{"speed","SPEED"},{"magnet","MAGNET"},{"income","COIN INCOME"}}) do
 local card=frame(upgradePanel,UDim2.fromOffset(169,305),UDim2.fromOffset((i-1)*180,0),Color3.fromRGB(38,56,61))
 text(card,entry[2],5,16,159,36,18)
 local status=text(card,"",10,70,149,130,16)
 cards[entry[1]]={status=status,button=button(card,"",9,235,151,52)}
end
local rarityColors={Common=Color3.fromRGB(182,203,190),Uncommon=Color3.fromRGB(128,218,147),Rare=Color3.fromRGB(110,179,255),Epic=Color3.fromRGB(198,135,255),Legendary=Color3.fromRGB(255,206,101),Mythic=Color3.fromRGB(255,126,191)}
local mode,zoneId,eggId,nearPart,dismissed
local cells={}
local busy=0
local function hide()
 panel.Visible=false;dismissed=eggId;mode=nil
 if player:GetAttribute("UIScreen")~="stats" then player:SetAttribute("UIScreen","") end
end
close.Activated:Connect(hide)
local function request(kind)
 if os.clock()<busy or not zoneId then return end
 busy=os.clock()+0.55;buy:FireServer(kind,zoneId,eggId)
end
for kind,card in pairs(cards) do card.button.Activated:Connect(function() request(kind) end) end
action.Activated:Connect(function() if mode=="egg" then request("egg") end end)
local function refresh()
 wallet.Text=string.format("Coins: %g",coins.Value)
 if eggId then
  local egg=Config.Eggs[eggId]
  title.Text=(mode=="index" and "PET INDEX · " or "")..egg.Name
  action.Text=mode=="index" and "Collect pets by opening eggs" or ("HATCH · "..egg.Cost.." COINS")
  action.Active=mode=="egg"
 end
 for _,cell in ipairs(cells) do cell.owned.Text=(player:GetAttribute("PetOwned"..cell.id) or 0)>0 and ("OWNED ×"..(player:GetAttribute("PetOwned"..cell.id) or 0)) or "UNDISCOVERED" end
 local values={speed=speed.Value,magnet=player:GetAttribute("MagnetLevel") or 0,income=player:GetAttribute("IncomeLevel") or 0}
 for kind,card in pairs(cards) do
  local n=values[kind]
  local maximum=kind=="speed" and Config.MaxSpeedLevel or (kind=="magnet" and Config.MaxMagnetLevel or Config.MaxIncomeLevel)
  local price=kind=="speed" and Config.GetUpgradeCost(n) or (kind=="magnet" and Config.GetMagnetUpgradeCost(n) or Config.GetIncomeUpgradeCost(n))
  local desc=kind=="speed" and (Config.GetWalkSpeed(n).." → "..Config.GetWalkSpeed(math.min(n+1,maximum))) or (kind=="magnet" and string.format("%.2f → %.2f studs",Config.GetMagnetRadius(n),Config.GetMagnetRadius(math.min(n+1,maximum))) or string.format("x%g → x%g",Config.GetIncomeMultiplier(n),Config.GetIncomeMultiplier(math.min(n+1,maximum))))
  card.status.Text=string.format("LEVEL %d / %d\n\n%s",n,maximum,desc)
  card.button.Text=n>=maximum and "MAX" or ("BUY · "..price)
  card.button.Active=n<maximum
  card.button.BackgroundColor3=coins.Value>=price and Color3.fromRGB(72,142,113) or Color3.fromRGB(98,81,81)
 end
end
local function buildGallery()
 gallery:ClearAllChildren();cells={}
 local egg=Config.Eggs[eggId]
 for i,entry in ipairs(egg.Pool) do
  local def=Config.Pets[entry.Pet]
  local x,y=(i-1)%5*107,math.floor((i-1)/5)*140
  local cell=button(gallery,"",x,y,102,132);cell.BackgroundColor3=Color3.fromRGB(37,53,61)
  local border=Instance.new("UIStroke",cell);border.Color=rarityColors[def.Rarity];border.Transparency=0.35
  local scene=viewport(cell,4,1,94,72)
  local model=PetVisuals.Build(entry.Pet);model.Parent=scene
  text(cell,def.Name,3,74,96,27,10)
  text(cell,string.format("%g%% · x%g",entry.Chance,def.Multiplier),3,101,96,15,11).TextColor3=rarityColors[def.Rarity]
  local owned=text(cell,"",3,117,96,12,9)
  table.insert(cells,{id=entry.Pet,owned=owned})
  local function hover() detail.Text=string.format("%s · %s · x%g coins · %g%%",def.Name,def.Rarity,def.Multiplier,entry.Chance) end
  cell.MouseEnter:Connect(hover);cell.Activated:Connect(hover)
 end
 refresh()
end
local function showEgg(id,indexMode)
 if mode==(indexMode and "index" or "egg") and eggId==id and panel.Visible then return end
 eggId=id;zoneId=Config.Eggs[id].World;mode=indexMode and "index" or "egg"
 local rootWorld=workspace:FindFirstChild("CoinSpeedWorld")
 local zone=rootWorld and (zoneId=="neon" and rootWorld:FindFirstChild("NeonCity") or rootWorld)
 local stand=zone and zone:FindFirstChild("EggStand"..id)
 nearPart=stand and stand.Interact
 gallery.Visible=true;upgradePanel.Visible=false;action.Visible=true;detail.Visible=true
 previous.Visible=indexMode;nextPage.Visible=indexMode
 player:SetAttribute("UIScreen",mode);panel.Visible=true;buildGallery()
end
previous.Activated:Connect(function() if mode=="index" then showEgg((eggId-2)%#Config.Eggs+1,true) end end)
nextPage.Activated:Connect(function() if mode=="index" then showEgg(eggId%#Config.Eggs+1,true) end end)
RS:WaitForChild("GameShopOpen").OnClientEvent:Connect(function(newMode,newZone,newEgg)
 if newMode=="egg" then showEgg(newEgg,false);return end
 mode="shop";zoneId=newZone
 local world=workspace.CoinSpeedWorld
 local zone=newZone=="neon" and world.NeonCity or world
 nearPart=zone.UpgradeShop.Counter
 title.Text="UPGRADE KIOSK";player:SetAttribute("UIScreen","shop")
 gallery.Visible=false;upgradePanel.Visible=true;action.Visible=false;detail.Visible=false;previous.Visible=false;nextPage.Visible=false;panel.Visible=true;refresh()
end)
player.PlayerGui:WaitForChild("OpenPetIndex").Event:Connect(function() showEgg(eggId or 1,true) end)
player:GetAttributeChangedSignal("UIScreen"):Connect(function()
 local active=player:GetAttribute("UIScreen")
 if active~="shop" and active~="egg" and active~="index" then panel.Visible=false;mode=nil end
end)
coins.Changed:Connect(refresh);speed.Changed:Connect(refresh);player.AttributeChanged:Connect(function(name) if name=="IncomeLevel" or name=="MagnetLevel" or string.sub(name,1,8)=="PetOwned" then refresh() end end)

local reveal=frame(gui,UDim2.fromOffset(385,385),UDim2.fromScale(0.5,0.5),Color3.fromRGB(29,38,57));reveal.AnchorPoint=Vector2.new(0.5,0.5);reveal.Visible=false
local revealScale=Instance.new("UIScale",reveal)
local revealTitle=text(reveal,"HATCHING",10,8,365,40,23)
local revealScene=viewport(reveal,10,48,365,260)
local resultText=text(reveal,"",12,312,361,62,17)
local revealModel,hatchStart,resultId,resultCount
local finished=false
local eggDisplays={}
local world=workspace:WaitForChild("CoinSpeedWorld")
for id,egg in ipairs(Config.Eggs) do
 local zone=egg.World=="neon" and world:WaitForChild("NeonCity") or world
 local stand=zone:WaitForChild("EggStand"..id)
 eggDisplays[id]={model=stand.EggDisplay,base=stand.EggDisplay:GetPivot(),part=stand.Interact}
end
RS:WaitForChild("GameHatched").OnClientEvent:Connect(function(id,count,sourceEgg)
 if not Config.Pets[id] then return end
 panel.Visible=false;mode=nil;dismissed=sourceEgg
 player:SetAttribute("UIScreen","hatch")
 if revealModel then revealModel:Destroy() end
 revealModel=eggDisplays[sourceEgg].model:Clone();revealModel.Parent=revealScene;revealModel:PivotTo(CFrame.identity)
 resultId=id;resultCount=count;hatchStart=os.clock();finished=false
 revealTitle.Text="HATCHING…";resultText.Text="A new companion awaits";reveal.Visible=true;busy=os.clock()+4.2
end)
local elapsed,scan=0,0
RunService.RenderStepped:Connect(function(dt)
 elapsed=elapsed+dt;scan=scan+dt
 local camera=workspace.CurrentCamera
 if camera then local size=camera.ViewportSize;scale.Scale=math.clamp(math.min(size.X/600,size.Y/500),0.3,1);revealScale.Scale=math.clamp(math.min(size.X/420,size.Y/440),0.3,1) end
 for id,entry in pairs(eggDisplays) do entry.model:PivotTo(entry.base*CFrame.new(0,math.sin(elapsed*1.5+id)*0.09,0)*CFrame.Angles(0,elapsed*0.45,0)) end
 if scan>0.15 then
  scan=0
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if mode=="shop" and panel.Visible and (not root or (root.Position-nearPart.Position).Magnitude>Config.ShopDistance+2) then hide() end
  local nearest,distance
  if root then for id,entry in pairs(eggDisplays) do local d=(root.Position-entry.part.Position).Magnitude;if d<11 and (not distance or d<distance) then nearest=id;distance=d end end end
  if not nearest then
   dismissed=nil
   if mode=="egg" then hide();dismissed=nil end
  elseif nearest~=dismissed and ((player:GetAttribute("UIScreen") or "")=="" or mode=="egg") then showEgg(nearest,false) end
 end
 if reveal.Visible then
  local t=os.clock()-hatchStart
  if t<1.5 then revealModel:PivotTo(CFrame.Angles(0,t*3,math.sin(t*25)*0.13))
  elseif not finished then
   finished=true;revealModel:Destroy();revealModel=PetVisuals.Build(resultId);revealModel.Parent=revealScene
   revealTitle.Text=Config.Pets[resultId].Name;revealTitle.TextColor3=rarityColors[Config.Pets[resultId].Rarity]
   resultText.Text=string.format("%s · x%g coins\n%s",Config.Pets[resultId].Rarity,Config.Pets[resultId].Multiplier,resultCount>1 and ("Duplicate · owned "..resultCount) or "New pet discovered!")
  else revealModel:PivotTo(CFrame.Angles(0,math.sin(t)*0.3,0)) end
  if t>4 then reveal.Visible=false;revealModel:Destroy();revealModel=nil;player:SetAttribute("UIScreen","") end
 end
end)
